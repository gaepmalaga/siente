rules_version = '2';

// Reglas de Firestore para las citas online de Siente.
// Se pegan en Firebase → Firestore Database → Reglas → Publicar.
//
// IMPORTANTE: pon aquí los correos de Google del equipo (los mismos que en
// src/data/citas.json → equipo). Solo ellos pueden ver los datos de los clientes.
//
// Hace falta activar en Authentication → Método de acceso: «Anónimo» (cada
// visitante recibe una identidad invisible al reservar, para poder cancelar su
// propia cita) y «Google» (para el equipo).

service cloud.firestore {
  match /databases/{database}/documents {

    function equipo() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'CORREO-DEL-EQUIPO@gmail.com'
        ];
    }

    function dueno(datos) {
      return request.auth != null && datos.uid == request.auth.uid;
    }

    // Celdas de agenda cogidas. Cualquiera puede verlas (para quitar esas horas)
    // pero no contienen ningún dato personal. Crear una celda que ya existe es
    // una modificación, que no está permitida: así dos personas no pueden
    // reservar el mismo hueco (la reserva entera se rechaza).
    match /ocupadas/{celda} {
      allow read: if true;
      allow create: if equipo() || (
        request.auth != null
        && request.resource.data.keys().hasOnly(['dia', 'cita', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.dia is string
        && request.resource.data.dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.cita is string
        && celda.matches('^' + request.resource.data.dia + '_[0-9]{4}_[0-8]$')
      );
      allow delete: if equipo() || dueno(resource.data);
    }

    // Datos de las citas: solo el equipo y quien la pidió desde su navegador.
    match /citas/{id} {
      allow get: if equipo() || dueno(resource.data);
      allow list: if equipo();
      allow create: if equipo() || (
        request.auth != null
        && request.resource.data.keys().hasOnly(['tipo', 'tipoNombre', 'fecha', 'hora', 'duracion', 'puesto', 'nombre', 'telefono', 'email', 'nota', 'estado', 'origen', 'creada', 'celdas', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.estado == 'confirmada'
        && request.resource.data.origen == 'web'
        && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 80
        && request.resource.data.telefono is string && request.resource.data.telefono.size() >= 9 && request.resource.data.telefono.size() <= 20
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.nota is string && request.resource.data.nota.size() <= 500
        && request.resource.data.fecha is string && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.hora is string && request.resource.data.hora.matches('^[0-9]{2}:[0-9]{2}$')
        && request.resource.data.celdas is list && request.resource.data.celdas.size() > 0 && request.resource.data.celdas.size() <= 12
      );
      allow update: if equipo() || (
        dueno(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
        && request.resource.data.estado == 'cancelada'
      );
      allow delete: if equipo();
    }
  }
}
