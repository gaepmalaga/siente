---
// Pedir cita online. Los huecos se calculan en el navegador con el horario, las
// citas configuradas en /admin y lo que ya está ocupado en Firestore. Si la
// reserva no está disponible, la página lleva a WhatsApp o al teléfono.
import Base from '../layouts/Base.astro';
import Migas from '../components/Migas.astro';
import Icono from '../components/Icono.astro';
import IconoMarca from '../components/IconoMarca.astro';
import EstadoApertura from '../components/EstadoApertura.astro';
import TablaHorario from '../components/TablaHorario.astro';
import { url } from '../lib/url';
import { negocio, telHref, waHref, WA_SALUDO, direccionCompleta, mapas, tiposCitaWeb, reservaOnline, citasParaCliente } from '../lib/negocio';

const tipos = tiposCitaWeb();
const reserva = reservaOnline();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: 'Pedir cita', ruta: '/pedir-cita/' },
];
---

<Base
  titulo="Pedir cita en la óptica y centro auditivo Siente (Barajas)"
  descripcion="Reserva tu cita online en Siente, óptica y centro auditivo en Barajas: elige el día y la hora y listo. Revisión de la vista gratis."
  migas={migas}
>
  <section class="cita-pagina">
    <div class="contenedor">
      <Migas migas={migas} />
      <header class="cita-cab">
        <span class="antetitulo">Menos de un minuto</span>
        <h1>Pide tu cita</h1>
        <p class="entradilla">
          {
            reserva
              ? 'Elige qué necesitas, el día y la hora que te vengan bien, y tu cita queda reservada al momento.'
              : 'Pide tu cita por WhatsApp o por teléfono y te damos hora enseguida.'
          }
        </p>
      </header>

      <div class="cita-rejilla">
        {
          reserva ? (
            <>
              <script id="citas-datos" type="application/json" set:html={citasParaCliente()} />
              <form class="asistente tarjeta" data-reserva data-direccion={direccionCompleta} novalidate>
                <fieldset class="paso-form">
                  <legend><span class="num mono">1</span> ¿Qué necesitas?</legend>
                  <div class="opciones">
                    {tipos.map((o, i) => (
                      <label class="opcion">
                        <input type="radio" name="tipo" value={o.id} checked={i === 0} />
                        <span class="opcion-caja">
                          <Icono nombre={o.icono} />
                          <span class="opcion-texto">
                            {o.nombre}
                            {o.detalle && <span class="etiqueta roble">{o.detalle}</span>}
                          </span>
                        </span>
                      </label>
                    ))}
                  </div>
                </fieldset>

                <fieldset class="paso-form">
                  <legend><span class="num mono">2</span> ¿Qué día te viene bien?</legend>
                  <div class="calendario" data-calendario>
                    <div class="cal-cab">
                      <button type="button" class="cal-nav" data-mes-anterior aria-label="Mes anterior"><Icono nombre="ChevronLeft" /></button>
                      <strong data-mes aria-live="polite"></strong>
                      <button type="button" class="cal-nav" data-mes-siguiente aria-label="Mes siguiente"><Icono nombre="ChevronRight" /></button>
                    </div>
                    <div class="cal-semana" aria-hidden="true"><span>L</span><span>M</span><span>X</span><span>J</span><span>V</span><span>S</span><span>D</span></div>
                    <div class="cal-dias" data-rejilla role="group" aria-label="Días disponibles"></div>
                  </div>
                  <p class="apagado" data-cargando>Buscando huecos libres…</p>
                  <p class="apagado" data-sin-huecos hidden>Ahora mismo no quedan huecos para esta cita en los próximos días. Escríbenos y buscamos uno.</p>
                </fieldset>

                <fieldset class="paso-form" data-paso-horas hidden>
                  <legend><span class="num mono">3</span> <span data-titulo-horas>¿A qué hora?</span></legend>
                  <div class="horas" data-horas role="radiogroup" aria-label="Hora"></div>
                </fieldset>

                <fieldset class="paso-form" data-paso-datos hidden>
                  <legend><span class="num mono">4</span> ¿A nombre de quién?</legend>
                  <label class="campo">
                    <span>Nombre</span>
                    <input type="text" name="nombre" autocomplete="name" required maxlength="80" placeholder="Por ejemplo, Carmen García" />
                    <span class="error" data-error="nombre" hidden>Escribe tu nombre para que sepamos quién eres.</span>
                  </label>
                  <label class="campo">
                    <span>Teléfono</span>
                    <input type="tel" name="telefono" autocomplete="tel" inputmode="tel" required maxlength="20" placeholder="Para avisarte si surge algo" />
                    <span class="error" data-error="telefono" hidden>Escribe un teléfono de 9 cifras.</span>
                  </label>
                  <label class="campo">
                    <span>Correo <em class="apagado">(opcional)</em></span>
                    <input type="email" name="email" autocomplete="email" maxlength="120" placeholder="tu@correo.com" />
                    <span class="error" data-error="email" hidden>Revisa el correo: parece incompleto.</span>
                  </label>
                  <label class="campo">
                    <span>¿Algo que debamos saber? <em class="apagado">(opcional)</em></span>
                    <textarea name="nota" rows="3" maxlength="500" placeholder="Por ejemplo: vengo con mi madre, o mis gafas actuales tienen 3 años"></textarea>
                  </label>
                  <label class="campo-web" aria-hidden="true">Web <input type="text" name="web" tabindex="-1" autocomplete="off" /></label>
                  <label class="acepto">
                    <input type="checkbox" name="acepto" />
                    <span>He leído la <a href={url('/politica-de-privacidad/')} target="_blank" rel="noopener">política de privacidad</a> y acepto que guardéis mis datos para gestionar la cita.</span>
                  </label>
                  <span class="error" data-error="acepto" hidden>Marca la casilla para poder reservar.</span>
                </fieldset>

                <div class="enviar" data-enviar hidden>
                  <p class="resumen" data-resumen></p>
                  <p class="error" data-aviso role="alert" hidden></p>
                  <button type="submit" class="boton bloque grande"><Icono nombre="CalendarCheck" /> Reservar mi cita</button>
                  <p class="privacidad"><Icono nombre="ShieldCheck" /> Solo guardamos tu nombre y teléfono para gestionar la cita. Puedes cancelarla desde aquí.</p>
                </div>

                <div class="hecho" data-hecho hidden tabindex="-1">
                  <span class="hecho-icono"><Icono nombre="PartyPopper" /></span>
                  <h2>¡Cita reservada!</h2>
                  <p data-hecho-texto></p>
                  <div class="hecho-acciones">
                    <button type="button" class="boton secundario" data-ics><Icono nombre="CalendarPlus" /> Añadir a mi calendario</button>
                    <button type="button" class="boton secundario" data-cancelar-ultima><Icono nombre="CalendarX" /> Cancelar esta cita</button>
                  </div>
                  <button type="button" class="enlace-flecha" data-otra>Reservar otra cita</button>
                </div>
              </form>

              <div class="tarjeta mis-citas" data-mis-citas hidden>
                <h2>Tus citas reservadas desde este dispositivo</h2>
                <ul data-lista-citas></ul>
              </div>

              <div class="tarjeta sin-reserva" data-sin-reserva hidden>
                <h2>La reserva online no está disponible ahora</h2>
                <p>Puedes pedir tu cita por WhatsApp o por teléfono y te damos hora enseguida.</p>
                <div class="sin-reserva-botones">
                  <a class="boton wa" href={waHref(WA_SALUDO)} target="_blank" rel="noopener"><IconoMarca nombre="whatsapp" /> Escribir por WhatsApp</a>
                  <a class="boton secundario" href={telHref()}><Icono nombre="Phone" /> Llamar</a>
                </div>
              </div>
            </>
          ) : (
            <div class="tarjeta sin-reserva">
              <h2>Pide tu cita</h2>
              <p>Escríbenos por WhatsApp o llámanos y te damos hora enseguida.</p>
              <div class="sin-reserva-botones">
                <a class="boton wa" href={waHref(WA_SALUDO)} target="_blank" rel="noopener"><IconoMarca nombre="whatsapp" /> Escribir por WhatsApp</a>
                <a class="boton secundario" href={telHref()}><Icono nombre="Phone" /> Llamar</a>
              </div>
            </div>
          )
        }

        <aside class="cita-lateral">
          <div class="tarjeta lateral-bloque">
            <h2>¿Tienes dudas?</h2>
            <p>Si no sabes qué cita elegir o necesitas algo distinto, pregúntanos antes de reservar.</p>
            <a class="boton wa" href={waHref('Hola, tengo una duda antes de pedir cita.')} target="_blank" rel="noopener"><IconoMarca nombre="whatsapp" /> Escribir por WhatsApp</a>
          </div>
          <div class="tarjeta lateral-bloque">
            <h2>Horario</h2>
            <EstadoApertura />
            <TablaHorario />
          </div>
          <div class="tarjeta lateral-bloque">
            <h2>Dónde estamos</h2>
            <p>{direccionCompleta}</p>
            <a class="enlace-flecha" href={mapas.comoLlegar} target="_blank" rel="noopener">Cómo llegar <Icono nombre="ArrowUpRight" /></a>
            <p class="apagado">Teléfono fijo: <a href={telHref()}>{negocio.telefono}</a><br />Móvil y WhatsApp: <a href={telHref(negocio.movil)}>{negocio.movil}</a></p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .cita-pagina { padding-block: 28px var(--seccion); }
  .cita-cab { display: grid; gap: 16px; margin: 28px 0 36px; }
  .cita-cab h1 { font-size: var(--paso-5); line-height: 0.98; letter-spacing: -0.045em; }
  .cita-rejilla { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; align-items: start; }
  @media (min-width: 1040px) {
    .cita-rejilla { grid-template-columns: minmax(0, 1fr) 360px; gap: 40px; }
    .cita-lateral { position: sticky; top: 110px; }
  }

  .asistente { position: relative; display: grid; gap: 36px; padding: clamp(22px, 4vw, 44px); }
  .asistente[hidden] { display: none; }
  .paso-form[hidden], .enviar[hidden] { display: none; }
  .paso-form { display: grid; gap: 18px; margin: 0; padding: 0; border: 0; min-width: 0; }
  legend { display: flex; align-items: center; gap: 14px; padding: 0; margin-bottom: 18px; font-size: var(--paso-2); font-weight: 800; letter-spacing: -0.02em; }
  .num { display: grid; place-items: center; width: 44px; height: 44px; flex: none; border-radius: 50%; background: var(--tinta); color: var(--luz); font-size: 1.3rem; }

  .opciones { display: grid; gap: 10px; }
  @media (min-width: 640px) { .opciones { grid-template-columns: 1fr 1fr; } }
  .opcion input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .opcion-caja {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 100%;
    min-height: 68px;
    padding: 14px 16px;
    border-radius: var(--radio-s);
    border: 2px solid var(--linea);
    background: var(--papel);
    font-weight: 700;
    line-height: 1.25;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .opcion-caja :global(.icono) { width: 28px; height: 28px; flex: none; color: var(--roble-oscuro); }
  .opcion-texto { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
  .opcion:hover .opcion-caja { border-color: var(--linea-fuerte); }
  .opcion input:checked + .opcion-caja { border-color: var(--tinta); background: var(--blanco); box-shadow: inset 0 0 0 1px var(--tinta); }
  .opcion input:focus-visible + .opcion-caja { outline: 3px solid var(--roble-oscuro); outline-offset: 2px; }


  .campo { display: grid; gap: 8px; font-weight: 700; }
  .campo input, .campo textarea {
    width: 100%;
    padding: 14px 16px;
    border-radius: var(--radio-s);
    border: 2px solid var(--linea-fuerte);
    background: var(--blanco);
    font-weight: 400;
    font-size: 1.15rem;
  }
  .campo input:focus, .campo textarea:focus { outline: none; border-color: var(--tinta); box-shadow: 0 0 0 4px rgb(185 132 79 / 0.3); }
  .campo em { font-style: normal; font-weight: 400; }
  .error { color: #a3301f; font-weight: 700; }
  .error[hidden] { display: none; }
  .campo:has([aria-invalid='true']) input { border-color: #a3301f; }

  .enviar { display: grid; gap: 12px; }
  .boton.grande { min-height: 66px; font-size: 1.2rem; }
  .enviar-otros { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .enviar-otros .boton { padding-inline: 0.8em; }
  .privacidad { display: flex; gap: 10px; align-items: flex-start; font-size: 0.98rem; color: var(--apagado); }
  .privacidad :global(.icono) { width: 20px; height: 20px; flex: none; margin-top: 2px; }

  .hecho {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 16px;
    padding: 32px;
    border-radius: var(--radio);
    background: var(--blanco);
    text-align: center;
  }
  .hecho[hidden] { display: none; }
  .hecho h2 { font-size: var(--paso-3); }
  .hecho p { max-width: 42ch; font-size: 1.15rem; }
  .hecho-icono { display: grid; place-items: center; width: 84px; height: 84px; border-radius: 50%; background: var(--tinta); color: var(--luz); }
  .hecho-icono :global(.icono) { width: 40px; height: 40px; }

  .cita-lateral { display: grid; gap: 18px; }
  .lateral-bloque { display: grid; gap: 14px; padding: 26px; }
  .lateral-bloque h2 { font-size: var(--paso-1); }

  .calendario { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; max-width: 460px; }
  .cal-cab { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-width: 0; text-transform: capitalize; font-size: 1.15rem; }
  .cal-nav { display: grid; place-items: center; flex: none; width: 48px; height: 48px; border-radius: 50%; border: 2px solid var(--linea); background: var(--papel); cursor: pointer; }
  .cal-nav:disabled { opacity: 0.3; cursor: not-allowed; }
  .cal-nav :global(.icono) { width: 22px; height: 22px; }
  .cal-semana, .cal-dias { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; }
  .cal-semana { text-align: center; font-weight: 700; color: var(--apagado); font-size: 0.95rem; }
  .cal-dias :global(button), .cal-dias :global(.vacio) { aspect-ratio: 1; min-width: 0; padding: 0; }
  .cal-dias :global(button) {
    border-radius: var(--radio-s); border: 2px solid var(--linea); background: var(--papel);
    font: inherit; font-weight: 700; font-size: 1.05rem; cursor: pointer;
  }
  .cal-dias :global(button:disabled) { border-color: transparent; background: transparent; color: var(--apagado); opacity: 0.45; cursor: not-allowed; font-weight: 400; }
  .cal-dias :global(button[aria-pressed='true']) { border-color: var(--tinta); background: var(--tinta); color: var(--papel); }
  .cal-dias :global(button:focus-visible), .horas :global(button:focus-visible), .cal-nav:focus-visible { outline: 3px solid var(--roble-oscuro); outline-offset: 2px; }
  .horas { display: grid; gap: 14px; }
  .horas :global(.horas-grupo) { display: flex; flex-wrap: wrap; gap: 8px; }
  .horas :global(.horas-titulo) { flex-basis: 100%; margin: 0; font-weight: 700; color: var(--apagado); }
  .horas :global(button) {
    min-height: 52px; min-width: 88px; padding: 0 18px; border-radius: 999px; border: 2px solid var(--linea);
    background: var(--papel); font: inherit; font-weight: 700; font-variant-numeric: tabular-nums; cursor: pointer;
  }
  .horas :global(button[aria-pressed='true']) { border-color: var(--tinta); background: var(--tinta); color: var(--papel); }
  .campo-web { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .acepto { display: flex; gap: 12px; align-items: flex-start; font-weight: 400; line-height: 1.4; }
  .acepto input { width: 24px; height: 24px; flex: none; margin-top: 2px; accent-color: var(--tinta); }
  .resumen { padding: 14px 16px; border-radius: var(--radio-s); background: var(--papel); border: 2px solid var(--linea); font-weight: 700; }
  .hecho-acciones { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .hecho .enlace-flecha { border: 0; background: none; font: inherit; cursor: pointer; text-decoration: underline; }
  .sin-reserva { display: grid; gap: 14px; padding: clamp(22px, 4vw, 44px); align-content: start; }
  .sin-reserva[hidden], .mis-citas[hidden] { display: none; }
  .sin-reserva-botones { display: flex; flex-wrap: wrap; gap: 10px; }
  .mis-citas { display: grid; gap: 12px; padding: 22px; }
  .mis-citas h2 { font-size: var(--paso-1); }
  .mis-citas ul { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .mis-citas li { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 14px; border: 2px solid var(--linea); border-radius: var(--radio-s); }
  .cita-rejilla > :global(.asistente), .cita-rejilla > :global(.sin-reserva) { min-width: 0; }
</style>
<script>
  import '../scripts/reserva';
</script>
