---
// Pedir cita sin servidor: el formulario compone un mensaje y abre WhatsApp
// (o el correo). La web no guarda ningún dato personal.
import Base from '../layouts/Base.astro';
import Migas from '../components/Migas.astro';
import Icono from '../components/Icono.astro';
import IconoMarca from '../components/IconoMarca.astro';
import EstadoApertura from '../components/EstadoApertura.astro';
import TablaHorario from '../components/TablaHorario.astro';
import { negocio, telHref, planVeoVigente, direccionCompleta, mapas } from '../lib/negocio';

const opciones = [
  { valor: 'revision-vista', texto: 'Revisión de la vista', detalle: 'Gratis', icono: 'ScanEye' },
  { valor: 'gafas', texto: 'Gafas graduadas o de sol', icono: 'Glasses' },
  { valor: 'progresivas', texto: 'Lentes progresivas', icono: 'Layers' },
  { valor: 'lentillas', texto: 'Lentillas o control de miopía', icono: 'Eye' },
  { valor: 'infantil', texto: 'Revisión visual infantil', icono: 'Baby' },
  ...(planVeoVigente() ? [{ valor: 'plan-veo', texto: 'Plan VEO (menores de 16)', detalle: 'Hasta 100 €', icono: 'Gift' }] : []),
  { valor: 'revision-oido', texto: 'Revisión auditiva', icono: 'Ear' },
  { valor: 'audifonos', texto: 'Audífonos', icono: 'AudioLines' },
  { valor: 'mantenimiento', texto: 'Ajuste o limpieza de audífonos', icono: 'Wrench' },
  { valor: 'otro', texto: 'Otra consulta', icono: 'MessageCircle' },
];
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: 'Pedir cita', ruta: '/pedir-cita/' },
];
---

<Base
  titulo="Pedir cita en la óptica y centro auditivo Siente (Barajas)"
  descripcion="Pide cita en Siente, óptica y centro auditivo en Barajas, en menos de un minuto por WhatsApp, teléfono o correo. Revisión de la vista gratis."
  migas={migas}
>
  <section class="cita-pagina">
    <div class="contenedor">
      <Migas migas={migas} />
      <header class="cita-cab">
        <span class="antetitulo">Menos de un minuto</span>
        <h1>Pide tu cita</h1>
        <p class="entradilla">Elige qué necesitas y cuándo te viene bien. Te abrimos WhatsApp con el mensaje ya escrito: solo tienes que enviarlo.</p>
      </header>

      <div class="cita-rejilla">
        <form class="asistente tarjeta" data-asistente data-whatsapp={negocio.whatsapp} data-email={negocio.email} novalidate>
          <!-- 1 -->
          <fieldset class="paso-form">
            <legend><span class="num mono">1</span> ¿Qué necesitas?</legend>
            <div class="opciones">
              {
                opciones.map((o, i) => (
                  <label class="opcion">
                    <input type="radio" name="servicio" value={o.valor} data-texto={o.texto} checked={i === 0} />
                    <span class="opcion-caja">
                      <Icono nombre={o.icono} />
                      <span class="opcion-texto">
                        {o.texto}
                        {o.detalle && <span class="etiqueta roble">{o.detalle}</span>}
                      </span>
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <!-- 2 -->
          <fieldset class="paso-form">
            <legend><span class="num mono">2</span> ¿Cuándo te viene bien?</legend>
            <div class="dias" data-dias role="radiogroup" aria-label="Día">
              <label class="dia">
                <input type="radio" name="dia" value="" data-texto="lo antes posible" checked />
                <span><strong>Lo antes</strong> posible</span>
              </label>
            </div>
            <div class="franjas" role="radiogroup" aria-label="Franja horaria">
              <label class="franja"><input type="radio" name="franja" value="indiferente" checked /><span><Icono nombre="Clock" /> Me da igual</span></label>
              <label class="franja" data-franja="manana"><input type="radio" name="franja" value="mañana" /><span><Icono nombre="Sun" /> Por la mañana</span></label>
              <label class="franja" data-franja="tarde"><input type="radio" name="franja" value="tarde" /><span><Icono nombre="Moon" /> Por la tarde</span></label>
            </div>
          </fieldset>

          <!-- 3 -->
          <fieldset class="paso-form">
            <legend><span class="num mono">3</span> ¿Cómo te llamas?</legend>
            <label class="campo">
              <span>Nombre</span>
              <input type="text" name="nombre" autocomplete="given-name" required placeholder="Por ejemplo, Carmen" />
              <span class="error" data-error hidden>Escribe tu nombre para que sepamos quién eres.</span>
            </label>
            <label class="campo">
              <span>¿Algo que debamos saber? <em class="apagado">(opcional)</em></span>
              <textarea name="nota" rows="3" placeholder="Por ejemplo: vengo con mi madre, o mis gafas actuales tienen 3 años"></textarea>
            </label>
          </fieldset>

          <div class="enviar">
            <button type="submit" class="boton wa bloque grande"><IconoMarca nombre="whatsapp" /> Enviar por WhatsApp</button>
            <div class="enviar-otros">
              <a class="boton secundario" href={telHref()}><Icono nombre="Phone" /> Prefiero llamar</a>
              <button type="button" class="boton secundario" data-email-boton><Icono nombre="Mail" /> Enviar por correo</button>
            </div>
            <p class="privacidad"><Icono nombre="ShieldCheck" /> No guardamos tus datos: el mensaje sale directamente de tu WhatsApp o tu correo.</p>
          </div>

          <div class="hecho" data-hecho hidden tabindex="-1">
            <span class="hecho-icono"><Icono nombre="PartyPopper" /></span>
            <h2>¡Ya casi está!</h2>
            <p>Se ha abierto WhatsApp con tu mensaje. <strong>Solo tienes que darle a enviar.</strong> Te confirmaremos la cita en cuanto lo veamos.</p>
            <p class="apagado">¿No se ha abierto? Llámanos al <a href={telHref()}>{negocio.telefono}</a>.</p>
            <button type="button" class="boton secundario" data-otra>Pedir otra cita</button>
          </div>
        </form>

        <aside class="cita-lateral">
          <div class="tarjeta lateral-bloque">
            <h2>Horario</h2>
            <EstadoApertura />
            <TablaHorario />
          </div>
          <div class="tarjeta lateral-bloque">
            <h2>Dónde estamos</h2>
            <p>{direccionCompleta}</p>
            <a class="enlace-flecha" href={mapas.comoLlegar} target="_blank" rel="noopener">Cómo llegar <Icono nombre="ArrowUpRight" /></a>
            <p class="apagado">Teléfono fijo: <a href={telHref()}>{negocio.telefono}</a><br />Móvil y WhatsApp: <a href={telHref(negocio.movil)}>{negocio.movil}</a></p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .cita-pagina { padding-block: 28px var(--seccion); }
  .cita-cab { display: grid; gap: 16px; margin: 28px 0 36px; }
  .cita-cab h1 { font-size: var(--paso-5); line-height: 0.98; letter-spacing: -0.045em; }
  .cita-rejilla { display: grid; gap: 28px; align-items: start; }
  @media (min-width: 1040px) {
    .cita-rejilla { grid-template-columns: 1fr 360px; gap: 40px; }
    .cita-lateral { position: sticky; top: 110px; }
  }

  .asistente { position: relative; display: grid; gap: 36px; padding: clamp(22px, 4vw, 44px); }
  .paso-form { display: grid; gap: 18px; margin: 0; padding: 0; border: 0; min-width: 0; }
  legend { display: flex; align-items: center; gap: 14px; padding: 0; margin-bottom: 18px; font-size: var(--paso-2); font-weight: 800; letter-spacing: -0.02em; }
  .num { display: grid; place-items: center; width: 44px; height: 44px; flex: none; border-radius: 50%; background: var(--tinta); color: var(--luz); font-size: 1.3rem; }

  .opciones { display: grid; gap: 10px; }
  @media (min-width: 640px) { .opciones { grid-template-columns: 1fr 1fr; } }
  .opcion input, .dias :global(.dia input), .franja input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .opcion-caja {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 100%;
    min-height: 68px;
    padding: 14px 16px;
    border-radius: var(--radio-s);
    border: 2px solid var(--linea);
    background: var(--papel);
    font-weight: 700;
    line-height: 1.25;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .opcion-caja :global(.icono) { width: 28px; height: 28px; flex: none; color: var(--roble-oscuro); }
  .opcion-texto { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
  .opcion:hover .opcion-caja { border-color: var(--linea-fuerte); }
  .opcion input:checked + .opcion-caja { border-color: var(--tinta); background: var(--blanco); box-shadow: inset 0 0 0 1px var(--tinta); }
  .opcion input:focus-visible + .opcion-caja,
  .dias :global(.dia input:focus-visible + span),
  .franja input:focus-visible + span { outline: 3px solid var(--roble-oscuro); outline-offset: 2px; }

  .dias { display: flex; flex-wrap: wrap; gap: 8px; }
  /* Los días se crean desde JavaScript: sus estilos tienen que ser globales. */
  .dias :global(.dia span) {
    display: grid;
    justify-items: center;
    min-width: 84px;
    padding: 10px 12px;
    border-radius: var(--radio-s);
    border: 2px solid var(--linea);
    background: var(--papel);
    line-height: 1.2;
    text-align: center;
    cursor: pointer;
  }
  .dias :global(.dia strong) { font-size: 1.05rem; }
  .dias :global(.dia input:checked + span) { border-color: var(--tinta); background: var(--tinta); color: var(--papel); }
  .franjas { display: flex; flex-wrap: wrap; gap: 8px; }
  .franja span {
    display: inline-flex; align-items: center; gap: 8px;
    min-height: 50px; padding: 0 18px;
    border-radius: 999px; border: 2px solid var(--linea); background: var(--papel);
    font-weight: 700; cursor: pointer;
  }
  .franja span :global(.icono) { width: 20px; height: 20px; }
  .franja input:checked + span { border-color: var(--tinta); background: var(--tinta); color: var(--papel); }
  .franja input:disabled + span { opacity: 0.35; cursor: not-allowed; text-decoration: line-through; }

  .campo { display: grid; gap: 8px; font-weight: 700; }
  .campo input, .campo textarea {
    width: 100%;
    padding: 14px 16px;
    border-radius: var(--radio-s);
    border: 2px solid var(--linea-fuerte);
    background: var(--blanco);
    font-weight: 400;
    font-size: 1.15rem;
  }
  .campo input:focus, .campo textarea:focus { outline: none; border-color: var(--tinta); box-shadow: 0 0 0 4px rgb(185 132 79 / 0.3); }
  .campo em { font-style: normal; font-weight: 400; }
  .error { color: #a3301f; font-weight: 700; }
  .error[hidden] { display: none; }
  .campo:has([aria-invalid='true']) input { border-color: #a3301f; }

  .enviar { display: grid; gap: 12px; }
  .boton.grande { min-height: 66px; font-size: 1.2rem; }
  .enviar-otros { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .enviar-otros .boton { padding-inline: 0.8em; }
  .privacidad { display: flex; gap: 10px; align-items: flex-start; font-size: 0.98rem; color: var(--apagado); }
  .privacidad :global(.icono) { width: 20px; height: 20px; flex: none; margin-top: 2px; }

  .hecho {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 16px;
    padding: 32px;
    border-radius: var(--radio);
    background: var(--blanco);
    text-align: center;
  }
  .hecho[hidden] { display: none; }
  .hecho h2 { font-size: var(--paso-3); }
  .hecho p { max-width: 42ch; font-size: 1.15rem; }
  .hecho-icono { display: grid; place-items: center; width: 84px; height: 84px; border-radius: 50%; background: var(--tinta); color: var(--luz); }
  .hecho-icono :global(.icono) { width: 40px; height: 40px; }

  .cita-lateral { display: grid; gap: 18px; }
  .lateral-bloque { display: grid; gap: 14px; padding: 26px; }
  .lateral-bloque h2 { font-size: var(--paso-1); }
</style>

<script>
  type Tramo = { abre: string; cierra: string };
  const CLAVES = ['domingo', 'lunes', 'martes', 'miercoles', 'jueves', 'viernes', 'sabado'];
  const CORTO = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];
  const LARGO = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
  const MESES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
  const MESES_LARGOS = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];

  const form = document.querySelector<HTMLFormElement>('[data-asistente]');
  const horario = JSON.parse(document.getElementById('horario-datos')?.textContent || '{}') as Record<string, Tramo[]>;

  if (form) {
    // Servicio preseleccionado desde la URL: /pedir-cita/?servicio=audifonos
    const pedido = new URLSearchParams(location.search).get('servicio');
    if (pedido) {
      const radio = form.querySelector<HTMLInputElement>(`input[name="servicio"][value="${CSS.escape(pedido)}"]`);
      if (radio) radio.checked = true;
    }

    // Próximos 6 días en los que el centro abre.
    const contenedor = form.querySelector('[data-dias]')!;
    const hoy = new Date();
    let anadidos = 0;
    for (let i = 0; anadidos < 6 && i < 21; i++) {
      const fecha = new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate() + i);
      const clave = CLAVES[fecha.getDay()];
      const tramos = horario[clave] ?? [];
      if (!tramos.length) continue;
      // Si hoy ya ha cerrado, no lo ofrecemos.
      if (i === 0) {
        const ahora = hoy.getHours() * 60 + hoy.getMinutes();
        const [h, m] = tramos[tramos.length - 1].cierra.split(':').map(Number);
        if (ahora > h * 60 + m - 30) continue;
      }
      const manana = tramos.some((t) => Number(t.abre.split(':')[0]) < 14);
      const tarde = tramos.some((t) => Number(t.cierra.split(':')[0]) >= 15);
      const etiqueta = i === 0 ? 'Hoy' : i === 1 ? 'Mañana' : CORTO[fecha.getDay()];
      const texto = `${i === 0 ? 'hoy' : i === 1 ? 'mañana' : `el ${LARGO[fecha.getDay()]}`} ${fecha.getDate()} de ${MESES_LARGOS[fecha.getMonth()]}`;
      const label = document.createElement('label');
      label.className = 'dia';
      label.innerHTML = `<input type="radio" name="dia" value="${clave}" data-texto="${texto}" data-manana="${manana}" data-tarde="${tarde}"><span><strong>${etiqueta}</strong>${fecha.getDate()} ${MESES[fecha.getMonth()]}</span>`;
      contenedor.appendChild(label);
      anadidos++;
    }

    // Desactiva «tarde» los días sin horario de tarde (p. ej. sábados).
    const franjas = (valor: string) => form.querySelector<HTMLInputElement>(`input[name="franja"][value="${valor}"]`)!;
    form.addEventListener('change', (e) => {
      const objetivo = e.target as HTMLInputElement;
      if (objetivo.name !== 'dia') return;
      const tarde = franjas('tarde');
      const manana = franjas('mañana');
      tarde.disabled = objetivo.dataset.tarde === 'false';
      manana.disabled = objetivo.dataset.manana === 'false';
      if ((tarde.disabled && tarde.checked) || (manana.disabled && manana.checked)) franjas('indiferente').checked = true;
    });

    const componer = () => {
      const datos = new FormData(form);
      const servicio = form.querySelector<HTMLInputElement>('input[name="servicio"]:checked')?.dataset.texto ?? 'una consulta';
      const dia = form.querySelector<HTMLInputElement>('input[name="dia"]:checked')?.dataset.texto ?? 'lo antes posible';
      const franja = String(datos.get('franja'));
      const nombre = String(datos.get('nombre') ?? '').trim();
      const nota = String(datos.get('nota') ?? '').trim();
      const cuando = franja === 'indiferente' ? dia : `${dia}, por la ${franja}`;
      const lineas = [
        `Hola, soy ${nombre}. Me gustaría pedir cita para: *${servicio}*.`,
        `📅 Me vendría bien ${cuando}.`,
        nota ? `📝 ${nota}` : '',
        '(Enviado desde la web)',
      ].filter(Boolean);
      return { nombre, texto: lineas.join('\n'), servicio };
    };

    const validar = () => {
      const campo = form.querySelector<HTMLInputElement>('input[name="nombre"]')!;
      const error = form.querySelector<HTMLElement>('[data-error]')!;
      const ok = campo.value.trim().length > 0;
      campo.setAttribute('aria-invalid', String(!ok));
      error.hidden = ok;
      if (!ok) campo.focus();
      return ok;
    };

    const terminado = () => {
      const hecho = form.querySelector<HTMLElement>('[data-hecho]')!;
      hecho.hidden = false;
      hecho.focus();
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!validar()) return;
      const { texto } = componer();
      const numero = (form.dataset.whatsapp ?? '').replace(/\D/g, '');
      window.open(`https://wa.me/${numero}?text=${encodeURIComponent(texto)}`, '_blank', 'noopener');
      terminado();
    });

    form.querySelector('[data-email-boton]')?.addEventListener('click', () => {
      if (!validar()) return;
      const { texto, servicio } = componer();
      location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(`Cita: ${servicio}`)}&body=${encodeURIComponent(texto.replace(/\*/g, ''))}`;
      terminado();
    });

    form.querySelector('[data-otra]')?.addEventListener('click', () => {
      form.querySelector<HTMLElement>('[data-hecho]')!.hidden = true;
      form.reset();
      window.scrollTo({ top: form.offsetTop - 120, behavior: 'smooth' });
    });
  }
</script>
