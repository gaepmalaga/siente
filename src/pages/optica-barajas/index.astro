---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Migas from '../../components/Migas.astro';
import Icono from '../../components/Icono.astro';
import IconoMarca from '../../components/IconoMarca.astro';
import TarjetaServicio from '../../components/TarjetaServicio.astro';
import BandaPlanVeo from '../../components/BandaPlanVeo.astro';
import Faq from '../../components/Faq.astro';
import BandaCita from '../../components/BandaCita.astro';
import { negocio, waHref } from '../../lib/negocio';
import { url } from '../../lib/url';
import { fotos } from '../../lib/fotos';
import { esquemaFaq } from '../../lib/schema';

const servicios = (await getCollection('servicios', (s) => s.data.area === 'vista')).sort((a, b) => a.data.order - b.data.order);
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: 'Óptica', ruta: '/optica-barajas/' },
];
const preguntas = servicios.flatMap((s) => s.data.faqs.slice(0, 1));
---

<Base
  titulo="Óptica en Barajas (Madrid) · Revisión de la vista gratis | Siente"
  descripcion="Óptica en Barajas con revisión de la vista gratis, gafas graduadas de marcas independientes, lentes progresivas, lentillas, control de miopía y gafas de sol. Avenida de Logroño, 112."
  migas={migas}
  imagen="/og/optica.png"
  esquemas={[esquemaFaq(preguntas)]}
>
  <section class="hub-hero">
    <div class="contenedor">
      <Migas migas={migas} />
      <div class="hub-rejilla">
        <div class="hub-texto">
          <span class="antetitulo">Óptica · Barajas, Madrid</span>
          <h1>Tu óptica en Barajas</h1>
          <p class="entradilla">
            Revisamos tu vista gratis, te ayudamos a elegir montura sin prisas y hacemos el seguimiento de tus gafas y
            lentillas. Todo en la {negocio.direccion.calle}.
          </p>
          <div class="hub-acciones">
            <a class="boton" href={url('/pedir-cita/?servicio=revision-vista')}><Icono nombre="CalendarCheck" /> Revisión gratis</a>
            <a class="boton wa" href={waHref('Hola, tengo una consulta sobre la óptica.')} target="_blank" rel="noopener"><IconoMarca nombre="whatsapp" /> WhatsApp</a>
          </div>
        </div>
        <div class="hub-fotos">
          <figure class="hf-1"><Image src={fotos['expositor-listones']} alt="Expositor de monturas iluminado junto a la pared de listones de la óptica Siente" widths={[400, 700]} sizes="(min-width: 1000px) 300px, 50vw" loading="eager" /></figure>
          <figure class="hf-2"><Image src={fotos['gafas-owlet']} alt="Gafas de acetato carey de la marca Owlet en Siente" widths={[400, 800]} sizes="(min-width: 1000px) 300px, 50vw" loading="eager" /></figure>
        </div>
      </div>
    </div>
  </section>

  <section class="seccion-s">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <span class="antetitulo">Servicios ópticos</span>
        <h2 class="titulo-seccion">Todo lo que necesitan <em>tus ojos</em></h2>
      </div>
      <div class="rejilla-servicios">
        {servicios.map((s, i) => <div data-aparecer style={`--retraso: ${(i % 3) * 0.08}s`}><TarjetaServicio servicio={s} /></div>)}
      </div>
    </div>
  </section>

  <section class="seccion destacado-gratis">
    <div class="contenedor dg-rejilla">
      <figure class="dg-foto madera" data-aparecer>
        <Image src={fotos['gabinete-optometria']} alt="Gabinete de optometría de Siente con foróptero y lámpara de hendidura" widths={[480, 800]} sizes="(min-width: 1000px) 480px, 100vw" />
      </figure>
      <div class="dg-texto" data-aparecer style="--retraso: 0.1s">
        <span class="etiqueta">Gratis y sin compromiso</span>
        <h2 class="titulo-seccion">Una revisión de la vista <em>de verdad</em>, no de cinco minutos</h2>
        <p class="entradilla">
          En nuestro gabinete medimos tu graduación de lejos, intermedia y de cerca, y comprobamos cómo trabajan juntos tus
          ojos. Después te explicamos el resultado con calma.
        </p>
        <ul role="list" class="dg-lista">
          <li><Icono nombre="ScanEye" /> Graduación completa para adultos y niños</li>
          <li><Icono nombre="Monitor" /> Consejo para pantallas, conducción y lectura</li>
          <li><Icono nombre="Stethoscope" /> Si vemos algo que deba valorar un oftalmólogo, te lo decimos</li>
        </ul>
        <a class="boton" href={url('/optica-barajas/revision-de-la-vista/')}>Cómo es la revisión <Icono nombre="ArrowRight" /></a>
      </div>
    </div>
  </section>

  <section class="seccion marcas-seccion">
    <div class="contenedor marcas-rejilla">
      <div class="cabecera-seccion">
        <span class="antetitulo">Monturas con carácter</span>
        <h2 class="titulo-seccion">Marcas independientes que no vas a ver en cada esquina</h2>
      </div>
      <div>
        <ul role="list" class="marcas">
          {negocio.marcas.map((m) => <li>{m}</li>)}
        </ul>
        <p class="entradilla">
          Acetatos carey, colores atrevidos, metales finos y modelos ultraligeros. Te asesoramos según la forma de tu cara
          para que aciertes a la primera.
        </p>
        <a class="enlace-flecha" href={url('/blog/visagismo-como-elegir-las-gafas-segun-la-forma-de-tu-cara-en-barajas/')}>
          Cómo elegir gafas según tu cara <Icono nombre="ArrowRight" />
        </a>
      </div>
    </div>
  </section>

  <BandaPlanVeo />

  <section class="seccion">
    <div class="contenedor">
      <Faq preguntas={preguntas} titulo="Dudas sobre la óptica" />
    </div>
  </section>

  <BandaCita servicio="revision-vista" titulo="Revisa tu vista gratis esta semana" />
</Base>

<style>
  .hub-hero { padding-block: 28px clamp(40px, 6vw, 72px); }
  .hub-rejilla { display: grid; gap: 40px; align-items: center; margin-top: 28px; }
  .hub-texto { display: grid; gap: 22px; justify-items: start; }
  .hub-texto h1 { font-size: var(--paso-5); line-height: 0.98; letter-spacing: -0.045em; max-width: 10ch; }
  .hub-acciones { display: flex; flex-wrap: wrap; gap: 12px; }
  .hub-fotos { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-items: end; }
  .hub-fotos figure { margin: 0; border-radius: var(--radio-l); overflow: hidden; }
  .hub-fotos :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hf-1 { aspect-ratio: 3 / 4; }
  .hf-2 { aspect-ratio: 3 / 4; transform: translateY(-36px); }
  @media (min-width: 1000px) { .hub-rejilla { grid-template-columns: 1.1fr 1fr; gap: 64px; } }

  .rejilla-servicios { display: grid; gap: 18px; }
  .rejilla-servicios > div { height: 100%; }
  @media (min-width: 680px) { .rejilla-servicios { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .rejilla-servicios { grid-template-columns: repeat(3, 1fr); } }

  .destacado-gratis { background: var(--papel-2); }
  .dg-rejilla { display: grid; gap: 44px; align-items: center; }
  .dg-foto { margin: 0; padding: 14px; border-radius: var(--radio-l); }
  .dg-foto :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: calc(var(--radio-l) - 10px); }
  .dg-texto { display: grid; gap: 22px; justify-items: start; }
  .dg-lista { display: grid; gap: 12px; font-weight: 700; font-size: 1.1rem; }
  .dg-lista li { display: flex; gap: 12px; align-items: flex-start; }
  .dg-lista :global(.icono) { width: 24px; height: 24px; flex: none; color: var(--roble-oscuro); }
  @media (min-width: 1000px) { .dg-rejilla { grid-template-columns: 0.9fr 1.1fr; gap: 72px; } .dg-foto { max-width: 480px; } }

  .marcas-rejilla { display: grid; gap: 12px 64px; }
  .marcas-rejilla > div:last-child { display: grid; gap: 22px; justify-items: start; }
  .marcas { display: flex; flex-wrap: wrap; gap: 10px; }
  .marcas li {
    padding: 12px 22px;
    border-radius: 999px;
    background: var(--blanco);
    box-shadow: var(--sombra-1);
    font-family: var(--mono);
    font-weight: 700;
    font-size: 1.15rem;
  }
  @media (min-width: 1000px) { .marcas-rejilla { grid-template-columns: 1fr 1fr; align-items: start; } }
</style>
