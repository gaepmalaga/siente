---
// Sustituto del Linktree para la bio de Instagram. Se edita desde /admin
// (Configuración → Página de enlaces).
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LogoMarca from '../components/LogoMarca.astro';
import Icono from '../components/Icono.astro';
import IconoMarca from '../components/IconoMarca.astro';
import EstadoApertura from '../components/EstadoApertura.astro';
import { enlacesPagina, resolverEnlace, negocio, waHref, WA_SALUDO, telHref, mapas } from '../lib/negocio';
import { url } from '../lib/url';

const enlaces = enlacesPagina.enlaces.filter((e) => e.visible).map((e) => ({ ...e, ...resolverEnlace(e) }));
const ultimo = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];

type Marca = 'whatsapp' | 'instagram' | 'facebook' | 'google';
function icono(e: (typeof enlaces)[number]): { marca?: Marca; lucide?: string } {
  if (e.tipo === 'whatsapp') return { marca: 'whatsapp' };
  if (e.tipo === 'instagram') return { marca: 'instagram' };
  if (e.tipo === 'facebook') return { marca: 'facebook' };
  if (e.tipo === 'resenas') return { marca: 'google' };
  if (e.tipo === 'cita') return { lucide: 'CalendarCheck' };
  if (e.tipo === 'llamar') return { lucide: 'Phone' };
  if (e.tipo === 'mapa') return { lucide: 'MapPin' };
  if (e.url.includes('plan-veo')) return { lucide: 'Gift' };
  if (e.url.includes('audifonos')) return { lucide: 'Ear' };
  if (e.url.includes('optica')) return { lucide: 'Glasses' };
  return { lucide: 'Globe' };
}
---

<Base
  titulo={`${enlacesPagina.titulo} · Enlaces`}
  descripcion="Pide cita, escríbenos por WhatsApp o encuentra cómo llegar a Siente, óptica y centro auditivo en Barajas."
  noindex
  desnuda
>
  <div class="enlaces madera">
    <div class="enlaces-col">
      <header class="enl-cab">
        <div class="enl-rotulo">
          <LogoMarca class="enl-gafas" animado />
          <span class="enl-nombre">SIENTE</span>
        </div>
        <h1>{enlacesPagina.titulo}</h1>
        {enlacesPagina.subtitulo && <p>{enlacesPagina.subtitulo}</p>}
        <span class="enl-estado"><EstadoApertura /></span>
      </header>

      <ul role="list" class="enl-lista">
        {
          enlaces.map((e, i) => {
            const ic = icono(e);
            return (
              <li style={`--i: ${i}`}>
                <a
                  class:list={['enl', { destacado: e.destacado, wa: e.tipo === 'whatsapp' && e.destacado }]}
                  href={e.href}
                  target={e.externo ? '_blank' : undefined}
                  rel={e.externo ? 'noopener' : undefined}
                >
                  <span class="enl-icono">{ic.marca ? <IconoMarca nombre={ic.marca} /> : <Icono nombre={ic.lucide!} />}</span>
                  <span class="enl-texto">
                    <strong>{e.texto}</strong>
                    {e.detalle && <span>{e.detalle}</span>}
                  </span>
                  <Icono nombre={e.externo ? 'ArrowUpRight' : 'ArrowRight'} class="enl-flecha" />
                </a>
              </li>
            );
          })
        }
      </ul>

      {
        ultimo && (
          <a class="enl-post" href={url(`/blog/${ultimo.id}/`)}>
            {ultimo.data.cover && <img src={url(ultimo.data.cover)} alt="" width="120" height="120" loading="lazy" />}
            <span>
              <small>Último del blog</small>
              <strong>{ultimo.data.title}</strong>
            </span>
          </a>
        )
      }

      <footer class="enl-pie">
        <div class="enl-redes">
          {negocio.redes.instagram && <a href={negocio.redes.instagram} target="_blank" rel="noopener" aria-label="Instagram"><IconoMarca nombre="instagram" /></a>}
          {negocio.redes.facebook && <a href={negocio.redes.facebook} target="_blank" rel="noopener" aria-label="Facebook"><IconoMarca nombre="facebook" /></a>}
          <a href={waHref(WA_SALUDO)} target="_blank" rel="noopener" aria-label="WhatsApp"><IconoMarca nombre="whatsapp" /></a>
          <a href={telHref()} aria-label="Llamar"><Icono nombre="Phone" /></a>
          <a href={mapas.comoLlegar} target="_blank" rel="noopener" aria-label="Cómo llegar"><Icono nombre="MapPin" /></a>
        </div>
        <p>{negocio.direccion.calle} · {negocio.direccion.barrio}, {negocio.direccion.ciudad}</p>
      </footer>
    </div>
  </div>
</Base>

<style>
  .enlaces {
    min-height: 100dvh;
    padding: 28px 16px 40px;
  }
  .enlaces::before {
    content: '';
    position: fixed;
    inset: 0;
    background: radial-gradient(120% 70% at 50% 0%, transparent 30%, rgb(30 16 6 / 0.55));
    pointer-events: none;
    z-index: -1;
  }
  .enlaces-col { display: grid; gap: 18px; width: min(100%, 520px); margin-inline: auto; }

  .enl-cab { display: grid; justify-items: center; gap: 10px; text-align: center; color: #fff8ec; padding-bottom: 8px; }
  .enl-rotulo { display: grid; justify-items: center; width: 220px; color: #f6e2c0; }
  .enl-rotulo :global(.enl-gafas) {
    width: 100%;
    filter: drop-shadow(0 0 4px rgb(255 222 165 / 0.95)) drop-shadow(0 0 18px rgb(255 196 120 / 0.65)) drop-shadow(0 0 44px rgb(255 170 90 / 0.4));
  }
  .enl-nombre {
    margin-top: 8px;
    font-family: var(--mono);
    font-weight: 700;
    font-size: 2.6rem;
    line-height: 1;
    letter-spacing: 0.05em;
    text-shadow: 0 0 4px rgb(255 222 165 / 0.95), 0 0 18px rgb(255 196 120 / 0.65), 0 0 44px rgb(255 170 90 / 0.45);
  }
  .enl-cab h1 { font-size: 1.35rem; letter-spacing: -0.01em; text-shadow: 0 2px 12px rgb(0 0 0 / 0.4); }
  .enl-cab p { font-size: 1rem; opacity: 0.92; text-shadow: 0 2px 10px rgb(0 0 0 / 0.45); }
  .enl-estado {
    padding: 8px 14px;
    border-radius: 999px;
    background: rgb(248 244 238 / 0.95);
    color: var(--tinta);
    font-size: 0.95rem;
    box-shadow: var(--sombra-1);
  }
  .enl-estado:has([hidden]) { display: none; }

  .enl-lista { display: grid; gap: 10px; }
  .enl {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 72px;
    padding: 12px 18px 12px 12px;
    border-radius: 20px;
    background: rgb(248 244 238 / 0.97);
    box-shadow: 0 10px 26px -14px rgb(20 10 2 / 0.7);
    text-decoration: none;
    transition: transform 0.18s, box-shadow 0.18s;
  }
  .enl:hover { transform: translateY(-2px) scale(1.01); box-shadow: 0 16px 34px -14px rgb(20 10 2 / 0.8); }
  .enl-icono {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex: none;
    border-radius: 14px;
    background: var(--tinta);
    color: var(--luz);
  }
  .enl-icono :global(.icono) { width: 24px; height: 24px; }
  .enl-texto { display: grid; flex: 1; line-height: 1.25; }
  .enl-texto strong { font-size: 1.08rem; }
  .enl-texto span { font-size: 0.92rem; color: var(--apagado); }
  .enl :global(.enl-flecha) { width: 20px; height: 20px; flex: none; color: var(--roble-oscuro); }
  .enl.destacado { background: var(--tinta); color: var(--papel); }
  .enl.destacado .enl-icono { background: var(--luz); color: var(--tinta); }
  .enl.destacado .enl-texto span { color: rgb(248 244 238 / 0.75); }
  .enl.destacado :global(.enl-flecha) { color: var(--luz); }
  .enl.wa { background: var(--wa); color: #fff; }
  .enl.wa .enl-icono { background: #fff; color: var(--wa-oscuro); }
  .enl.wa .enl-texto span { color: rgb(255 255 255 / 0.85); }
  .enl.wa :global(.enl-flecha) { color: #fff; }
  @media (prefers-reduced-motion: no-preference) {
    .enl-lista li { animation: subir 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: calc(0.25s + var(--i) * 0.06s); }
  }
  @keyframes subir { from { opacity: 0; transform: translateY(14px); } }

  .enl-post {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px;
    border-radius: 20px;
    background: rgb(23 20 17 / 0.82);
    color: var(--papel);
    text-decoration: none;
    backdrop-filter: blur(6px);
  }
  .enl-post img { width: 64px; height: 64px; flex: none; border-radius: 14px; object-fit: cover; }
  .enl-post small { display: block; font-family: var(--mono); text-transform: uppercase; letter-spacing: 0.12em; color: var(--roble-claro); font-size: 0.75rem; }
  .enl-post strong { font-size: 1rem; line-height: 1.3; }

  .enl-pie { display: grid; justify-items: center; gap: 12px; padding-top: 8px; color: #fff8ec; text-align: center; font-size: 0.92rem; }
  .enl-redes { display: flex; gap: 10px; }
  .enl-redes a {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgb(248 244 238 / 0.95);
    color: var(--tinta);
  }
  .enl-redes :global(.icono) { width: 22px; height: 22px; }
  .enl-pie p { text-shadow: 0 2px 10px rgb(0 0 0 / 0.5); }
</style>
