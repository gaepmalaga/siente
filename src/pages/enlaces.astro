---
// Sustituto del Linktree para la bio de Instagram. Se edita desde /admin
// (Configuración → Página de enlaces). Pocos botones grandes para lo
// importante y una fila de enlaces pequeños para lo demás.
import { getCollection } from 'astro:content';
import { esPublico } from '../lib/blog';
import Base from '../layouts/Base.astro';
import LogoMarca from '../components/LogoMarca.astro';
import Icono from '../components/Icono.astro';
import IconoMarca from '../components/IconoMarca.astro';
import EstadoApertura from '../components/EstadoApertura.astro';
import { enlacesPagina, resolverEnlace, negocio, planVeoVigente, planVeoFin } from '../lib/negocio';
import { url } from '../lib/url';

const esPlanVeo = (u: string) => u.includes('plan-veo');
const enlaces = enlacesPagina.enlaces
  .filter((e) => e.visible && (planVeoVigente() || !esPlanVeo(e.url)))
  .map((e) => ({ ...e, ...resolverEnlace(e) }));
const principales = enlaces.filter((e) => !e.secundario);
const secundarios = enlaces.filter((e) => e.secundario);
const ultimo = (await getCollection('blog', esPublico)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];
const diasPlanVeo = Math.max(0, Math.ceil((planVeoFin.getTime() - Date.now()) / 86_400_000));

type Marca = 'whatsapp' | 'instagram' | 'facebook' | 'google';
function icono(e: (typeof enlaces)[number]): { marca?: Marca; lucide?: string } {
  if (e.tipo === 'whatsapp') return { marca: 'whatsapp' };
  if (e.tipo === 'instagram') return { marca: 'instagram' };
  if (e.tipo === 'facebook') return { marca: 'facebook' };
  if (e.tipo === 'resenas') return { marca: 'google' };
  if (e.tipo === 'cita') return { lucide: 'CalendarCheck' };
  if (e.tipo === 'llamar') return { lucide: 'Phone' };
  if (e.tipo === 'mapa') return { lucide: 'MapPin' };
  if (e.tipo === 'contacto') return { lucide: 'UserRoundPlus' };
  if (esPlanVeo(e.url)) return { lucide: 'Gift' };
  if (e.url.includes('audifonos')) return { lucide: 'Ear' };
  if (e.url.includes('optica')) return { lucide: 'Glasses' };
  return { lucide: 'Globe' };
}
---

<Base
  titulo={`${enlacesPagina.titulo} · Enlaces`}
  descripcion="Pide cita, escríbenos por WhatsApp o encuentra cómo llegar a Siente, óptica y centro auditivo en Barajas."
  noindex
  desnuda
>
  <div class="enlaces madera" data-zona="bio-instagram">
    <div class="enlaces-col">
      <header class="enl-cab">
        <div class="enl-rotulo">
          <LogoMarca class="enl-gafas" animado />
          <span class="enl-nombre">SIENTE</span>
        </div>
        <h1>{enlacesPagina.titulo}</h1>
        {enlacesPagina.subtitulo && <p>{enlacesPagina.subtitulo}</p>}
        <div class="enl-estado">
          <EstadoApertura />
          <span class="enl-hoy" data-horario-hoy hidden></span>
        </div>
      </header>

      <ul role="list" class="enl-lista">
        {
          principales.map((e, i) => {
            const ic = icono(e);
            const pv = esPlanVeo(e.url);
            return (
              <li style={`--i: ${i}`} data-fin={pv ? negocio.planVeo.fin : undefined}>
                <a
                  class:list={['enl', { destacado: e.destacado, wa: e.tipo === 'whatsapp' && e.destacado }]}
                  href={e.href}
                  target={e.externo ? '_blank' : undefined}
                  rel={e.externo ? 'noopener' : undefined}
                >
                  <span class="enl-icono">{ic.marca ? <IconoMarca nombre={ic.marca} /> : <Icono nombre={ic.lucide!} />}</span>
                  <span class="enl-texto">
                    <strong>{e.texto}</strong>
                    {e.detalle && <span>{e.detalle}</span>}
                    {pv && (
                      <span class="enl-cuenta">
                        <Icono nombre="Hourglass" /> Quedan <b data-pv-dias>{diasPlanVeo}</b> días
                      </span>
                    )}
                  </span>
                  <Icono nombre={e.externo ? 'ArrowUpRight' : 'ArrowRight'} class="enl-flecha" />
                </a>
              </li>
            );
          })
        }
      </ul>

      {
        secundarios.length > 0 && (
          <ul role="list" class="enl-secundarios">
            {secundarios.map((e) => {
              const ic = icono(e);
              return (
                <li>
                  <a
                    class="enl-sec"
                    href={e.href}
                    target={e.externo ? '_blank' : undefined}
                    rel={e.externo ? 'noopener' : undefined}
                    download={e.tipo === 'contacto' ? 'Siente.vcf' : undefined}
                  >
                    {ic.marca ? <IconoMarca nombre={ic.marca} /> : <Icono nombre={ic.lucide!} />}
                    <span>{e.texto}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        )
      }

      {
        ultimo && (
          <a class="enl-post" href={url(`/blog/${ultimo.id}/`)}>
            {ultimo.data.cover && <img src={url(ultimo.data.cover)} alt="" width="120" height="120" loading="lazy" />}
            <span>
              <small>Último del blog</small>
              <strong>{ultimo.data.title}</strong>
            </span>
          </a>
        )
      }

      <footer class="enl-pie">
        {
          negocio.redes.facebook && (
            <a class="enl-fb" href={negocio.redes.facebook} target="_blank" rel="noopener">
              <IconoMarca nombre="facebook" /> También en Facebook
            </a>
          )
        }
        <p>{negocio.direccion.calle} · {negocio.direccion.barrio}, {negocio.direccion.ciudad}</p>
      </footer>
    </div>
  </div>
</Base>

<style>
  .enlaces {
    min-height: 100dvh;
    padding: 24px 16px 36px;
  }
  .enlaces::before {
    content: '';
    position: fixed;
    inset: 0;
    background: radial-gradient(120% 70% at 50% 0%, transparent 30%, rgb(30 16 6 / 0.55));
    pointer-events: none;
    z-index: -1;
  }
  .enlaces-col { display: grid; gap: 16px; width: min(100%, 520px); margin-inline: auto; }

  .enl-cab { display: grid; justify-items: center; gap: 8px; text-align: center; color: #fff8ec; padding-bottom: 6px; }
  .enl-rotulo { display: grid; justify-items: center; width: 190px; color: #f6e2c0; }
  .enl-rotulo :global(.enl-gafas) {
    width: 100%;
    filter: drop-shadow(0 0 4px rgb(255 222 165 / 0.95)) drop-shadow(0 0 18px rgb(255 196 120 / 0.65)) drop-shadow(0 0 44px rgb(255 170 90 / 0.4));
  }
  .enl-nombre {
    margin-top: 6px;
    font-family: var(--mono);
    font-weight: 700;
    font-size: 2.3rem;
    line-height: 1;
    letter-spacing: 0.05em;
    text-shadow: 0 0 4px rgb(255 222 165 / 0.95), 0 0 18px rgb(255 196 120 / 0.65), 0 0 44px rgb(255 170 90 / 0.45);
  }
  .enl-cab h1 { font-size: 1.3rem; letter-spacing: -0.01em; text-shadow: 0 2px 12px rgb(0 0 0 / 0.4); }
  .enl-cab p { font-size: 1rem; opacity: 0.92; text-shadow: 0 2px 10px rgb(0 0 0 / 0.45); }
  .enl-estado {
    display: grid;
    justify-items: center;
    gap: 2px;
    padding: 9px 16px;
    border-radius: 18px;
    background: rgb(248 244 238 / 0.95);
    color: var(--tinta);
    font-size: 0.95rem;
    box-shadow: var(--sombra-1);
  }
  .enl-estado:not(:has(> :not([hidden]))) { display: none; }
  .enl-hoy { color: var(--apagado); font-size: 0.9rem; font-variant-numeric: tabular-nums; }
  .enl-hoy[hidden] { display: none; }

  .enl-lista { display: grid; gap: 10px; }
  .enl-lista li[hidden] { display: none; }
  .enl {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 74px;
    padding: 12px 18px 12px 12px;
    border-radius: 20px;
    background: rgb(248 244 238 / 0.97);
    box-shadow: 0 10px 26px -14px rgb(20 10 2 / 0.7);
    text-decoration: none;
    transition: transform 0.18s, box-shadow 0.18s;
  }
  .enl:hover { transform: translateY(-2px) scale(1.01); box-shadow: 0 16px 34px -14px rgb(20 10 2 / 0.8); }
  .enl-icono {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    flex: none;
    border-radius: 14px;
    background: var(--tinta);
    color: var(--luz);
  }
  .enl-icono :global(.icono) { width: 25px; height: 25px; }
  .enl-texto { display: grid; flex: 1; gap: 1px; line-height: 1.25; }
  .enl-texto strong { font-size: 1.1rem; }
  .enl-texto > span { font-size: 0.93rem; color: var(--apagado); }
  .enl-texto > .enl-cuenta {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    justify-self: start;
    margin-top: 5px;
    padding: 3px 10px;
    border-radius: 999px;
    background: #f6d9d3;
    color: #7a2a1d;
    font-weight: 700;
    font-size: 0.85rem;
  }
  .enl-cuenta :global(.icono) { width: 14px; height: 14px; }
  .enl :global(.enl-flecha) { width: 20px; height: 20px; flex: none; color: var(--roble-oscuro); }
  .enl.destacado { background: var(--tinta); color: var(--papel); }
  .enl.destacado .enl-icono { background: var(--luz); color: var(--tinta); }
  .enl.destacado .enl-texto > span { color: rgb(248 244 238 / 0.75); }
  .enl.destacado :global(.enl-flecha) { color: var(--luz); }
  .enl.wa { background: var(--wa); color: #fff; }
  .enl.wa .enl-icono { background: #fff; color: var(--wa-oscuro); }
  .enl.wa .enl-texto > span { color: rgb(255 255 255 / 0.88); }
  .enl.wa :global(.enl-flecha) { color: #fff; }
  @media (prefers-reduced-motion: no-preference) {
    .enl-lista li { animation: subir 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: calc(0.25s + var(--i) * 0.06s); }
  }
  @keyframes subir { from { opacity: 0; transform: translateY(14px); } }

  .enl-secundarios { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .enl-sec {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 52px;
    padding: 8px 12px;
    border-radius: 16px;
    background: rgb(23 20 17 / 0.78);
    color: var(--papel);
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition: background 0.15s;
  }
  .enl-sec:hover { background: rgb(23 20 17 / 0.92); }
  .enl-sec :global(.icono) { width: 19px; height: 19px; flex: none; color: var(--luz); }

  .enl-post {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px;
    border-radius: 20px;
    background: rgb(248 244 238 / 0.95);
    text-decoration: none;
  }
  .enl-post img { width: 64px; height: 64px; flex: none; border-radius: 14px; object-fit: cover; }
  .enl-post small { display: block; font-family: var(--mono); text-transform: uppercase; letter-spacing: 0.12em; color: var(--roble-oscuro); font-size: 0.75rem; }
  .enl-post strong { font-size: 1rem; line-height: 1.3; }

  .enl-pie { display: grid; justify-items: center; gap: 10px; padding-top: 6px; color: #fff8ec; text-align: center; font-size: 0.92rem; }
  .enl-fb {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgb(248 244 238 / 0.95);
    color: var(--tinta);
    font-weight: 700;
    text-decoration: none;
  }
  .enl-fb :global(.icono) { width: 18px; height: 18px; color: #1877f2; }
  .enl-pie p { text-shadow: 0 2px 10px rgb(0 0 0 / 0.5); }
</style>
