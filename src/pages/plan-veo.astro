---
import Base from '../layouts/Base.astro';
import Migas from '../components/Migas.astro';
import Icono from '../components/Icono.astro';
import IconoMarca from '../components/IconoMarca.astro';
import Faq from '../components/Faq.astro';
import BandaCita from '../components/BandaCita.astro';
import { negocio, waHref, planVeoVigente, planVeoFin } from '../lib/negocio';
import { url } from '../lib/url';
import { esquemaFaq } from '../lib/schema';

const vigente = planVeoVigente();
const fechaFin = planVeoFin.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Madrid' });
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: 'Plan VEO', ruta: '/plan-veo/' },
];

const preguntas = [
  {
    q: '¿Quién puede beneficiarse del Plan VEO?',
    a: 'Niños, niñas y adolescentes de hasta 16 años (inclusive) con un problema de refracción diagnosticado y derecho a asistencia sanitaria pública, incluidas las mutualidades MUFACE, MUGEJU e ISFAS. No depende de los ingresos de la familia.',
  },
  {
    q: '¿Cuánto cubre la ayuda?',
    a: 'Hasta 100 € por persona y año para gafas graduadas o lentes de contacto (en lentillas, las unidades y el líquido necesarios para un año). Si el producto cuesta menos de 100 €, no pagas nada; si cuesta más, solo pagas la diferencia.',
  },
  {
    q: '¿Quién hace la prescripción?',
    a: 'Si el menor tiene menos de 5 años, la prescripción debe hacerla un servicio de oftalmología, público o privado. En niños más mayores también puede hacerla el óptico-optometrista de una óptica participante, como Siente.',
  },
  {
    q: '¿Tengo que hacer algún trámite online?',
    a: 'No. La solicitud es presencial en la óptica y somos nosotros quienes la tramitamos con el Ministerio de Sanidad. Tú solo tienes que venir con el menor y la documentación.',
  },
  {
    q: '¿Hasta cuándo se puede pedir?',
    a: `Según el Ministerio de Sanidad, la ayuda está disponible hasta el ${fechaFin}, inclusive.`,
  },
];

const documentos = [
  'Tarjeta sanitaria del menor (código CIPA) o certificado de la comunidad autónoma.',
  'DNI o documento identificativo del menor, si lo tiene.',
  'DNI o documento identificativo del padre, madre o tutor legal.',
  'Prescripción del problema de refracción, si ya la tienes (si no, la hacemos aquí cuando la edad lo permite).',
];
---

<Base
  titulo="Plan VEO en Barajas: gafas gratis para menores de 16 | Óptica Siente"
  descripcion="Óptica adherida al Plan VEO en Barajas. Gafas y lentillas para menores de 16 años con hasta 100 € de ayuda al año. Lo tramitamos nosotros, sin papeleo online."
  migas={migas}
  imagen="/og/plan-veo.png"
  noindex={!vigente}
  esquemas={[esquemaFaq(preguntas)]}
>
  <section class="pv-hero">
    <div class="contenedor">
      <Migas migas={migas} />
      <div class="pv-rejilla">
        <div class="pv-texto">
          <span class="etiqueta">Plan VEO · Ministerio de Sanidad</span>
          <h1>Gafas para tus hijos, <span class="subrayado">con hasta 100 €</span> de ayuda pública</h1>
          <p class="entradilla">
            En Siente somos <strong>óptica adherida al Plan VEO</strong>. Si tu hijo o hija tiene 16 años o menos y necesita
            gafas o lentillas, nos encargamos de todo el trámite en el momento.
          </p>
          {
            vigente ? (
              <div class="pv-acciones">
                <a class="boton" href={url('/pedir-cita/?servicio=plan-veo')}><Icono nombre="CalendarCheck" /> Pedir cita Plan VEO</a>
                <a class="boton wa" href={waHref('Hola, quería información sobre el Plan VEO para mi hijo/a.')} target="_blank" rel="noopener"><IconoMarca nombre="whatsapp" /> Preguntar</a>
              </div>
            ) : (
              <p class="aviso-fin">El Plan VEO terminó el {fechaFin}. Seguimos revisando la vista a los peques: pide cita.</p>
            )
          }
        </div>
        <div class="pv-tarjetas">
          <div class="pv-cifra-grande"><span class="mono">100 €</span><small>por menor y año</small></div>
          <div class="pv-mini"><Icono nombre="Baby" /><span>Hasta <strong>16 años</strong> inclusive</span></div>
          <div class="pv-mini"><Icono nombre="FileText" /><span><strong>Sin papeleo</strong> online</span></div>
          <div class="pv-mini" data-fin={negocio.planVeo.fin}><Icono nombre="Hourglass" /><span>Hasta el <strong>{fechaFin}</strong></span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <span class="antetitulo">Así de fácil</span>
        <h2 class="titulo-seccion">Cómo funciona en Siente</h2>
      </div>
      <ol role="list" class="pasos">
        <li><span class="paso-num mono">1</span><h3>Pides cita</h3><p>Por WhatsApp, teléfono o la web. Te decimos qué traer.</p></li>
        <li><span class="paso-num mono">2</span><h3>Revisamos su vista</h3><p>Si tiene la edad para ello, hacemos la prescripción aquí mismo, gratis.</p></li>
        <li><span class="paso-num mono">3</span><h3>Elegís las gafas</h3><p>Monturas resistentes y cómodas, o lentillas si son adecuadas para su edad.</p></li>
        <li><span class="paso-num mono">4</span><h3>Nosotros tramitamos</h3><p>Gestionamos la ayuda con el Ministerio. Si cuesta menos de 100 €, no pagas nada.</p></li>
      </ol>
    </div>
  </section>

  <section class="seccion documentos">
    <div class="contenedor doc-rejilla">
      <div class="cabecera-seccion">
        <span class="antetitulo">Qué traer</span>
        <h2 class="titulo-seccion">Documentación necesaria</h2>
        <p class="entradilla">Ven con el menor y esta documentación. Si te falta algo, pregúntanos antes por WhatsApp.</p>
      </div>
      <ul role="list" class="checklist tarjeta">
        {documentos.map((d) => <li><Icono nombre="CircleCheck" /> {d}</li>)}
      </ul>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <Faq preguntas={preguntas} titulo="Dudas sobre el Plan VEO" />
      <p class="fuente">
        Información basada en la web oficial del Ministerio de Sanidad sobre el Plan VEO. Consulta siempre las condiciones
        vigentes en <a href="https://www.sanidad.gob.es/areas/carteraServicios/planVeo.htm" target="_blank" rel="noopener">sanidad.gob.es</a>.
      </p>
    </div>
  </section>

  <BandaCita servicio="plan-veo" titulo="Aprovecha el Plan VEO antes de que termine" />
</Base>

<style>
  .pv-hero {
    padding-block: 28px clamp(48px, 7vw, 96px);
    background: #f6d9d3;
    background-image: radial-gradient(60% 120% at 100% 0%, rgb(255 255 255 / 0.6), transparent 60%);
  }
  .pv-rejilla { display: grid; gap: 40px; align-items: center; margin-top: 28px; }
  .pv-texto { display: grid; gap: 22px; justify-items: start; }
  .pv-texto h1 { font-size: var(--paso-4); max-width: 17ch; }
  .subrayado { background: linear-gradient(180deg, transparent 62%, rgb(255 255 255 / 0.85) 62%); }
  .pv-acciones { display: flex; flex-wrap: wrap; gap: 12px; }
  .aviso-fin { padding: 14px 18px; border-radius: var(--radio-s); background: var(--blanco); font-weight: 700; }
  .pv-tarjetas { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .pv-cifra-grande {
    grid-column: 1 / -1;
    display: grid;
    gap: 4px;
    padding: 32px;
    border-radius: var(--radio-l);
    background: var(--tinta);
    color: var(--papel);
    box-shadow: var(--sombra-2);
  }
  .pv-cifra-grande span { font-weight: 700; font-size: clamp(4rem, 3rem + 4vw, 6.5rem); line-height: 1; color: var(--luz); }
  .pv-cifra-grande small { font-size: 1.2rem; }
  .pv-mini { display: grid; gap: 8px; padding: 20px; border-radius: var(--radio); background: var(--blanco); box-shadow: var(--sombra-1); }
  .pv-mini :global(.icono) { width: 28px; height: 28px; color: var(--roble-oscuro); }
  .pv-mini:last-child { grid-column: 1 / -1; }
  @media (min-width: 1000px) { .pv-rejilla { grid-template-columns: 1.3fr 1fr; gap: 64px; } }

  .pasos { display: grid; gap: 18px; }
  @media (min-width: 720px) { .pasos { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .pasos { grid-template-columns: repeat(4, 1fr); } }
  .pasos li { display: grid; gap: 12px; align-content: start; padding: 28px; border-radius: var(--radio); border: 1.5px solid var(--linea-fuerte); }
  .paso-num { display: grid; place-items: center; width: 54px; height: 54px; border-radius: 50%; background: var(--tinta); color: var(--luz); font-weight: 700; font-size: 1.5rem; }
  .pasos h3 { font-size: var(--paso-1); }
  .pasos p { color: var(--tinta-2); }

  .documentos { background: var(--papel-2); }
  .doc-rejilla { display: grid; gap: 12px 64px; align-items: start; }
  @media (min-width: 1000px) { .doc-rejilla { grid-template-columns: 1fr 1.2fr; } }
  .checklist { display: grid; gap: 0; padding: 12px 28px; }
  .checklist li { display: flex; gap: 14px; align-items: flex-start; padding: 18px 0; border-bottom: 1px solid var(--linea); font-size: 1.12rem; }
  .checklist li:last-child { border-bottom: 0; }
  .checklist :global(.icono) { width: 26px; height: 26px; flex: none; color: var(--roble-oscuro); }

  .fuente { margin-top: 32px; font-size: 0.98rem; color: var(--apagado); }
  .fuente a { color: var(--tinta); font-weight: 700; }
</style>
