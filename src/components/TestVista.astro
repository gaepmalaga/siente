---
// Test de vista online: pre-revisión guiada de unos 5 minutos (calibración de la
// pantalla con una tarjeta, agudeza visual, astigmatismo, color, cuadrícula de
// Amsler) con un informe en semáforo. Todo ocurre en el navegador: no se envía
// ni se guarda nada. Es orientativo y no sustituye a una revisión.
//
// La lógica (tamaños, puntuación, semáforo) está en src/lib/testVista.ts.
import { negocio, telHref, waHref } from '../lib/negocio';
import { url } from '../lib/url';

const citaUrl = url('/pedir-cita/?servicio=revision-vista');
---

<div
  class="tv"
  data-tv
  data-cita={citaUrl}
  data-wa={waHref()}
  data-tel={telHref()}
  data-telefono={negocio.telefono}
  data-contacto={url('/contacto/')}
>
  <noscript>
    <p class="tv-sinjs">
      Este test necesita JavaScript. Puedes pedir una revisión de la vista gratuita en
      <a href={citaUrl}>la página de citas</a> o llamarnos al <a href={telHref()}>{negocio.telefono}</a>.
    </p>
  </noscript>
  <div class="tv-cab" data-cab hidden>
    <div class="tv-progreso" role="progressbar" aria-label="Progreso del test" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-progreso>
      <span data-barra></span>
    </div>
    <p class="tv-paso" data-paso></p>
  </div>
  <div class="tv-escena" data-escena aria-live="polite"></div>
</div>

<style is:global>
  .tv {
    --tv-ok: #1b7a3e;
    --tv-ok-fondo: #e4f3e8;
    --tv-revisar: #94560a;
    --tv-revisar-fondo: #fbefd9;
    --tv-pronto: #b3261e;
    --tv-pronto-fondo: #fbe4e1;
    position: relative;
    background: var(--blanco);
    border-radius: var(--radio-l);
    box-shadow: var(--sombra-2);
    border: 1px solid var(--linea);
    overflow: hidden;
    min-height: 560px;
  }
  .tv-sinjs { padding: 32px; font-size: 1.1rem; }
  .tv-cab { display: grid; gap: 10px; padding: 20px clamp(20px, 4vw, 40px) 0; }
  .tv-cab[hidden] { display: none; }
  .tv-progreso { height: 8px; border-radius: 99px; background: var(--papel-2); overflow: hidden; }
  .tv-progreso span {
    display: block;
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--roble), var(--roble-oscuro));
    transition: width 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tv-paso { font-size: 0.95rem; font-weight: 700; color: var(--apagado); letter-spacing: 0.02em; }

  .tv-escena { padding: clamp(20px, 4vw, 40px); display: grid; gap: 24px; align-content: start; }
  /* Pruebas con respuesta rápida: todo cabe en una pantalla de móvil, sin scroll. */
  .tv-escena.compacta { gap: 14px; padding-top: 14px; padding-bottom: 16px; }
  @media (prefers-reduced-motion: no-preference) {
    .tv-escena > * { animation: tv-entra 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
    .tv-escena > *:nth-child(2) { animation-delay: 0.06s; }
    .tv-escena > *:nth-child(3) { animation-delay: 0.12s; }
    .tv-escena > *:nth-child(4) { animation-delay: 0.18s; }
  }
  @keyframes tv-entra { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  .tv h2, .tv h3 { font-size: var(--paso-3); line-height: 1.1; }
  .tv h3 { font-size: var(--paso-2); }
  .tv-texto { font-size: 1.12rem; line-height: 1.55; color: var(--tinta-2); max-width: 56ch; }
  .tv-texto strong { color: var(--tinta); }
  .tv-chico { font-size: 0.95rem; color: var(--apagado); max-width: 60ch; }
  .tv-acciones { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .tv-acciones .boton[disabled] { opacity: 0.4; pointer-events: none; }

  /* Opciones tipo botón de radio */
  .tv-grupo { display: grid; gap: 10px; border: 0; padding: 0; margin: 0; }
  .tv-grupo legend { font-weight: 800; font-size: 1.08rem; margin-bottom: 4px; padding: 0; }
  .tv-opciones { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 10px; }
  .tv-opcion { position: relative; display: block; cursor: pointer; }
  .tv-opcion input { position: absolute; opacity: 0; inset: 0; }
  .tv-opcion span {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 60px;
    padding: 12px 16px;
    border-radius: var(--radio-s);
    border: 2px solid var(--linea-fuerte);
    font-weight: 700;
    transition: background 0.15s, border-color 0.15s;
  }
  .tv-opcion small { display: block; font-weight: 400; color: var(--apagado); font-size: 0.88rem; }
  .tv-opcion:hover span { background: var(--papel); }
  .tv-opcion input:checked + span { border-color: var(--tinta); background: var(--papel-2); box-shadow: inset 0 0 0 1px var(--tinta); }
  .tv-opcion input:focus-visible + span { outline: 3px solid var(--roble-oscuro); outline-offset: 3px; }

  .tv-alerta {
    display: grid;
    gap: 12px;
    padding: 20px;
    border-radius: var(--radio-s);
    background: var(--tv-pronto-fondo);
    border: 2px solid var(--tv-pronto);
    color: #5c130f;
  }
  .tv-alerta strong { font-size: 1.15rem; }
  .tv-alerta[hidden], .tv [hidden] { display: none !important; }
  .tv-aviso-legal {
    display: flex;
    gap: 10px;
    padding: 14px 16px;
    border-radius: var(--radio-s);
    background: var(--papel);
    font-size: 0.95rem;
    color: var(--tinta-2);
  }
  .tv-aviso-legal svg { flex: none; width: 20px; height: 20px; margin-top: 2px; }

  /* Calibración */
  .tv-calib { display: grid; justify-items: center; gap: 18px; }
  .tv-tarjeta {
    position: relative;
    aspect-ratio: 53.98 / 85.6;
    border-radius: 3.2% / 2%;
    background: linear-gradient(135deg, #f1e9dd, #e6d6bf);
    border: 2px solid var(--tinta);
    box-shadow: 0 0 0 9999px transparent;
    display: grid;
    place-items: center;
    color: var(--tinta-2);
    font-weight: 700;
    text-align: center;
    padding: 14px;
    max-width: 100%;
  }
  .tv-tarjeta::before, .tv-tarjeta::after {
    content: '';
    position: absolute;
    top: -14px;
    bottom: -14px;
    width: 0;
    border-left: 2px dashed var(--roble-oscuro);
    pointer-events: none;
  }
  .tv-tarjeta::before { left: -1px; }
  .tv-tarjeta::after { right: -1px; }
  .tv-calib-control { display: flex; gap: 12px; align-items: center; width: min(100%, 460px); }
  .tv-calib-control input[type='range'] { flex: 1; accent-color: var(--roble-oscuro); height: 44px; }
  .tv-paso-boton {
    width: 52px;
    height: 52px;
    flex: none;
    border-radius: 50%;
    border: 2px solid var(--tinta);
    background: var(--blanco);
    font-size: 1.6rem;
    font-weight: 700;
    cursor: pointer;
    line-height: 1;
  }
  .tv-paso-boton:hover { background: var(--tinta); color: var(--papel); }

  /* Indicador de ojo */
  .tv-ojo-cab { display: flex; gap: 18px; align-items: center; }
  .tv-ojos { width: 150px; flex: none; }
  .tv-ojos .mano { transform-origin: center; animation: tv-mano 2.4s ease-in-out infinite; }
  @keyframes tv-mano { 50% { transform: translateY(-3px) scale(1.03); } }
  .tv-ojo-cab p { font-size: 1.25rem; font-weight: 800; line-height: 1.25; }
  .tv-ojo-cab small { display: block; font-weight: 400; color: var(--apagado); font-size: 0.98rem; margin-top: 2px; }

  /* Distancia */
  .tv-dist { display: flex; gap: 16px; align-items: center; padding: 16px 20px; border-radius: var(--radio-s); background: var(--papel); }
  .tv-dist b { font-family: var(--mono); font-size: 2.2rem; line-height: 1; white-space: nowrap; }
  .tv-dist span { color: var(--tinta-2); }

  /* Escenario de optotipos */
  .tv-escenario {
    display: grid;
    place-items: center;
    min-height: 190px; /* respaldo */
    min-height: clamp(140px, 24svh, 230px);
    background: #fff;
    border: 2px solid var(--linea-fuerte);
    border-radius: var(--radio);
    padding: 20px;
    overflow: hidden;
  }
  .tv-optotipo { display: block; transition: opacity 0.12s; }
  .tv-optotipo.oculto { opacity: 0; }
  .tv-cruz { display: grid; grid-template-columns: repeat(3, minmax(0, 76px)); grid-template-rows: repeat(3, 76px); gap: 8px; justify-content: center; }
  .tv-flecha {
    border-radius: 18px;
    border: 2px solid var(--tinta);
    background: var(--blanco);
    cursor: pointer;
    display: grid;
    place-items: center;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.12s, transform 0.12s;
  }
  .tv-flecha svg { width: 34px; height: 34px; }
  .tv-flecha:hover { background: var(--papel-2); }
  .tv-flecha:active { transform: scale(0.94); background: var(--tinta); color: var(--papel); }
  .tv-flecha[data-dir='arriba'] { grid-area: 1 / 2; }
  .tv-flecha[data-dir='izq'] { grid-area: 2 / 1; }
  .tv-flecha[data-dir='der'] { grid-area: 2 / 3; }
  .tv-flecha[data-dir='abajo'] { grid-area: 3 / 2; }
  .tv-nover { grid-area: 2 / 2; font-size: 0.8rem; font-weight: 800; line-height: 1.1; border-radius: 18px; border: 2px dashed var(--linea-fuerte); background: transparent; cursor: pointer; padding: 4px; }
  .tv-nover:hover { background: var(--papel); }
  .tv-puntos { display: flex; gap: 6px; justify-content: center; }
  .tv-puntos i { width: 8px; height: 8px; border-radius: 50%; background: var(--linea-fuerte); }
  .tv-puntos i.hecho { background: var(--roble-oscuro); }

  /* Astigmatismo */
  .tv-dial-caja { display: grid; place-items: center; background: #fff; border: 2px solid var(--linea-fuerte); border-radius: var(--radio); padding: 12px; }
  .tv-dial line.l { stroke: #000; transition: stroke 0.2s; }
  .tv-dial line.l.sel { stroke: var(--roble-oscuro); }
  .tv-dial text { font-family: var(--sans); font-weight: 800; fill: var(--apagado); }
  .tv-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .tv-chip { position: relative; cursor: pointer; }
  .tv-chip input { position: absolute; opacity: 0; inset: 0; }
  .tv-chip span {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 8px 18px;
    border-radius: 99px;
    border: 2px solid var(--linea-fuerte);
    font-weight: 800;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .tv-chip:hover span { background: var(--papel); }
  .tv-chip input:checked + span { background: var(--tinta); color: var(--papel); border-color: var(--tinta); }
  .tv-chip input:focus-visible + span { outline: 3px solid var(--roble-oscuro); outline-offset: 3px; }

  /* Color */
  .tv-lamina { display: grid; place-items: center; }
  .tv-lamina canvas { max-width: 100%; height: auto; border-radius: 50%; box-shadow: 0 10px 30px -12px rgb(23 20 17 / 0.45); background: #fff; }
  .tv-numeros { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .tv-numero {
    min-height: 64px;
    border-radius: var(--radio-s);
    border: 2px solid var(--tinta);
    background: var(--blanco);
    font: 800 1.7rem var(--sans);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .tv-numero:hover { background: var(--papel-2); }
  .tv-numero:active { background: var(--tinta); color: var(--papel); }
  .tv-ninguno { min-height: 52px; border-radius: var(--radio-s); border: 2px dashed var(--linea-fuerte); background: transparent; font-weight: 800; cursor: pointer; }
  .tv-ninguno:hover { background: var(--papel); }

  /* Amsler */
  .tv-amsler-caja { display: grid; place-items: center; background: #fff; border: 2px solid var(--linea-fuerte); border-radius: var(--radio); padding: 12px; overflow: hidden; }
  .tv-amsler { touch-action: manipulation; cursor: crosshair; }
  .tv-amsler rect.marca { fill: rgb(179 38 30 / 0.35); stroke: var(--tv-pronto); stroke-width: 1.5; }
  .tv-amsler rect.celda { fill: transparent; }
  .tv-amsler rect.celda:hover { fill: rgb(135 87 44 / 0.12); }

  /* Informe */
  .tv-veredicto {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(16px, 3vw, 28px);
    align-items: center;
    padding: clamp(20px, 3vw, 32px);
    border-radius: var(--radio);
    background: var(--tv-fondo);
    border: 2px solid var(--tv-color);
  }
  .tv-veredicto[data-s='ok'] { --tv-color: var(--tv-ok); --tv-fondo: var(--tv-ok-fondo); }
  .tv-veredicto[data-s='revisar'] { --tv-color: var(--tv-revisar); --tv-fondo: var(--tv-revisar-fondo); }
  .tv-veredicto[data-s='pronto'] { --tv-color: var(--tv-pronto); --tv-fondo: var(--tv-pronto-fondo); }
  .tv-sello { width: clamp(72px, 14vw, 104px); height: clamp(72px, 14vw, 104px); }
  .tv-sello circle { fill: none; stroke: var(--tv-color); stroke-width: 6; stroke-linecap: round; stroke-dasharray: 327; stroke-dashoffset: 327; transform: rotate(-90deg); transform-origin: center; }
  .tv-sello path { fill: none; stroke: var(--tv-color); stroke-width: 7; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 90; stroke-dashoffset: 90; }
  @media (prefers-reduced-motion: no-preference) {
    .tv-sello circle { animation: tv-trazo 1s 0.15s cubic-bezier(0.3, 0.6, 0.2, 1) forwards; }
    .tv-sello path { animation: tv-trazo 0.6s 0.9s ease-out forwards; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tv-sello circle, .tv-sello path { stroke-dashoffset: 0; }
  }
  @keyframes tv-trazo { to { stroke-dashoffset: 0; } }
  .tv-veredicto h2 { font-size: var(--paso-3); color: var(--tv-color); }
  .tv-veredicto p { margin-top: 8px; font-size: 1.1rem; line-height: 1.5; color: var(--tinta-2); }

  .tv-filas { display: grid; gap: 12px; }
  .tv-fila {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 16px;
    align-items: start;
    padding: 18px 20px;
    border-radius: var(--radio-s);
    border: 1.5px solid var(--linea-fuerte);
    border-left: 8px solid var(--tv-color);
  }
  .tv-fila[data-s='ok'] { --tv-color: var(--tv-ok); }
  .tv-fila[data-s='revisar'] { --tv-color: var(--tv-revisar); }
  .tv-fila[data-s='pronto'] { --tv-color: var(--tv-pronto); }
  .tv-fila h3 { font-size: 1.15rem; grid-column: 1; }
  .tv-etiqueta {
    grid-column: 2;
    justify-self: end;
    padding: 3px 12px;
    border-radius: 99px;
    font-size: 0.85rem;
    font-weight: 800;
    color: #fff;
    background: var(--tv-color);
    white-space: nowrap;
  }
  .tv-fila p { grid-column: 1 / -1; color: var(--tinta-2); line-height: 1.5; }
  .tv-medidor { grid-column: 1 / -1; display: grid; gap: 6px; margin-block: 4px; }
  .tv-medidor-fila { display: grid; grid-template-columns: 78px 1fr auto; gap: 10px; align-items: center; font-size: 0.95rem; }
  .tv-segmentos { display: grid; grid-template-columns: repeat(8, 1fr); gap: 3px; }
  .tv-segmentos i { height: 12px; border-radius: 4px; background: var(--papel-2); }
  .tv-segmentos i.on { background: var(--tv-color); }
  .tv-medidor-fila b { font-family: var(--mono); font-size: 1.05rem; white-space: nowrap; }
  .tv-seg-ok i.on { background: var(--tv-ok); }
  .tv-seg-revisar i.on { background: var(--tv-revisar); }
  .tv-seg-pronto i.on { background: var(--tv-pronto); }

  @media (max-width: 560px) {
    .tv-veredicto { grid-template-columns: 1fr; justify-items: start; }
    .tv-ojos { width: 110px; }
    .tv-cruz { grid-template-columns: repeat(3, minmax(0, 64px)); grid-template-rows: repeat(3, 64px); gap: 6px; }
    .tv-medidor-fila { grid-template-columns: 62px 1fr auto; }
    .tv-fila { grid-template-columns: 1fr; }
    .tv-etiqueta { grid-column: 1; justify-self: start; }
  }

  /* ── Ajustes, ayuda de calibración y brillo ─────────────────────────── */
  .tv-ajustes { display: grid; gap: 24px; }
  .tv-ayuda { width: min(100%, 200px); justify-self: center; }
  .tv-ayuda .tarjeta-anim { animation: tv-apoya 2.6s ease-in-out infinite; }
  @keyframes tv-apoya { 0%, 20% { transform: translate(34px, -16px); opacity: 0.6; } 60%, 100% { transform: none; opacity: 1; } }
  .tv-grises { display: grid; grid-template-columns: repeat(6, 1fr); background: #000; border-radius: var(--radio-s); padding: 10px; gap: 6px; }
  .tv-grises i { height: 36px; border-radius: 6px; }

  /* Cámara y voz */
  .tv-camara, .tv-voz { display: grid; gap: 8px; justify-items: start; }
  .tv-camara-vista { display: flex; gap: 14px; align-items: center; }
  .tv-camara-vista video { width: 110px; height: 82px; object-fit: cover; border-radius: 12px; background: #000; transform: scaleX(-1); }
  .tv-camara-vista p { font-weight: 800; }
  .tv-voz { justify-items: center; text-align: center; }
  .tv-voz [aria-pressed='true'] { background: var(--tv-pronto); border-color: var(--tv-pronto); color: #fff; }

  /* Duocromo */
  .tv-duo { display: grid; grid-template-columns: 1fr 1fr; border-radius: var(--radio); overflow: hidden; border: 2px solid var(--linea-fuerte); }
  .tv-duo-lado { display: grid; grid-template-columns: repeat(2, auto); gap: clamp(16px, 5vw, 36px); justify-content: center; align-content: center; min-height: 180px; padding: 22px 8px; }
  .tv-duo-lado .tv-optotipo { color: #000; }

  /* Lectura de cerca */
  .tv-cerca { display: grid; gap: 8px; }
  .tv-linea-cerca { position: relative; display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; align-items: center; padding: 12px 14px; border-radius: var(--radio-s); border: 2px solid var(--linea-fuerte); cursor: pointer; transition: background 0.15s, border-color 0.15s; }
  .tv-linea-cerca:hover { background: var(--papel); }
  .tv-linea-cerca input { position: absolute; opacity: 0; inset: 0; }
  .tv-linea-cerca:has(input:checked) { border-color: var(--tinta); background: var(--papel-2); box-shadow: inset 0 0 0 1px var(--tinta); }
  .tv-linea-cerca:has(input:focus-visible) { outline: 3px solid var(--roble-oscuro); outline-offset: 3px; }
  .tv-linea-texto { color: #000; line-height: 1.3; }
  .tv-linea-cerca em { font-style: normal; font-size: 0.8rem; font-weight: 800; color: var(--apagado); text-align: right; }
</style>

<script>
  import {
    ACIERTOS_PARA_SUPERAR,
    DISTANCIA_AMSLER_MM,
    DISTANCIA_CERCA_MM,
    DISTANCIA_MM,
    ESCALA_GRISES,
    INTENTOS_POR_NIVEL,
    LAMINAS_COLOR,
    LINEAS_ASTIGMATISMO,
    NIVELES,
    NIVELES_CERCA,
    TARJETA_MM,
    alturaMayusculasMm,
    anguloLinea,
    casillasAmsler,
    consejoDistancia,
    diametroPx,
    distanciaCamaraMm,
    elaborarInforme,
    icsRecordatorio,
    notaCita,
    opcionesLamina,
    pxPorMm,
    resolverAgudeza,
    resolverColor,
    resumenTexto,
    textoDecimal,
    textoDuocromo,
    textoEjeLinea,
    type Dispositivo,
    type EdadNino,
    type Ojo,
    type Perfil,
    type ResultadoAmsler,
    type ResultadoAstigmatismo,
    type ResultadoCerca,
    type ResultadoDuocromo,
    type Resultados,
    type Semaforo,
  } from '../lib/testVista';

  type Tipo = 'intro' | 'calibrar' | 'agudeza' | 'duocromo' | 'astigmatismo' | 'cerca' | 'color' | 'amsler' | 'informe';
  type Paso = { tipo: Tipo; ojo?: Ojo };

  const OJOS: Ojo[] = ['derecho', 'izquierdo'];
  // Adultos: primero un ojo con todas sus pruebas y después el otro (así solo se cambia la mano una vez).
  const PASOS_ADULTO: Paso[] = [
    { tipo: 'intro' },
    { tipo: 'calibrar' },
    ...OJOS.flatMap((ojo) => (['agudeza', 'duocromo', 'astigmatismo', 'amsler'] as Tipo[]).map((tipo) => ({ tipo, ojo }))),
    { tipo: 'cerca' },
    { tipo: 'color' },
    { tipo: 'informe' },
  ];
  const PASOS_NINO: Paso[] = [
    { tipo: 'intro' },
    { tipo: 'calibrar' },
    { tipo: 'agudeza', ojo: 'derecho' },
    { tipo: 'agudeza', ojo: 'izquierdo' },
    { tipo: 'color' },
    { tipo: 'informe' },
  ];
  const TITULOS: Record<Tipo, string> = {
    intro: 'Antes de empezar',
    calibrar: 'Calibrar la pantalla',
    agudeza: 'Agudeza visual',
    duocromo: 'Rojo y verde',
    astigmatismo: 'Líneas (astigmatismo)',
    cerca: 'Visión de cerca',
    color: 'Visión del color',
    amsler: 'Cuadrícula de Amsler',
    informe: 'Tu resultado',
  };
  const NOMBRE_OJO: Record<Ojo, string> = { derecho: 'ojo derecho', izquierdo: 'ojo izquierdo' };
  const OTRO_OJO: Record<Ojo, Ojo> = { derecho: 'izquierdo', izquierdo: 'derecho' };

  const cuadrar = (m: number) => Math.round(m * 100) / 100;
  const ico = {
    flecha: (giro: number) =>
      `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="transform:rotate(${giro}deg)" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`,
    info: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>`,
    cita: `<svg class="icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4M16 2v4M3 10h18"/><rect x="3" y="4" width="18" height="18" rx="2"/><path d="m9 16 2 2 4-4"/></svg>`,
    wa: `<svg class="icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>`,
    mic: `<svg class="icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v4"/></svg>`,
    cam: `<svg class="icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3z"/><circle cx="12" cy="13" r="3"/></svg>`,
  };

  // Eventos de Google Analytics (solo si la persona ha aceptado las cookies; si no, no hacen nada).
  const evento = (nombre: string, datos: Record<string, unknown> = {}) => {
    try {
      (window as unknown as { sienteEvento?: (n: string, d?: Record<string, unknown>) => void }).sienteEvento?.(nombre, datos);
    } catch {}
  };

  document.querySelectorAll<HTMLElement>('[data-tv]').forEach(iniciar);

  function iniciar(raiz: HTMLElement) {
    const escena = raiz.querySelector<HTMLElement>('[data-escena]')!;
    const cab = raiz.querySelector<HTMLElement>('[data-cab]')!;
    const barra = raiz.querySelector<HTMLElement>('[data-barra]')!;
    const progreso = raiz.querySelector<HTMLElement>('[data-progreso]')!;
    const etiquetaPaso = raiz.querySelector<HTMLElement>('[data-paso]')!;

    // ── Estado ────────────────────────────────────────────────────────────
    let PASOS = PASOS_ADULTO;
    let indice = 0;
    let dispositivo: Dispositivo = window.matchMedia('(pointer: coarse)').matches ? 'movil' : 'ordenador';
    let usaGafas = false;
    let perfil: Perfil = 'adulto';
    let edadNino: EdadNino = 'mayor6';
    let brilloBajo = false;
    let pxMm = dispositivo === 'movil' ? 6.3 : 3.78;
    let anchoTarjetaPx = pxMm * TARJETA_MM.ancho;
    try {
      const g = Number(localStorage.getItem('siente-tv-px'));
      if (g > 1.5 && g < 14) {
        pxMm = g;
        anchoTarjetaPx = g * TARJETA_MM.ancho;
      }
    } catch {}

    const agudeza: Partial<Record<Ojo, number[]>> = {};
    const astigmatismo: Partial<Record<Ojo, ResultadoAstigmatismo>> = {};
    const duocromo: Partial<Record<Ojo, ResultadoDuocromo>> = {};
    let cerca: ResultadoCerca | undefined;
    let respuestasColor: (number | null)[] = [];
    const amsler: Partial<Record<Ojo, ResultadoAmsler>> = {};
    // Limpiezas del paso actual (cámara, micrófono, teclado).
    let limpiezas: (() => void)[] = [];

    // ── Utilidades ────────────────────────────────────────────────────────
    const paso = () => PASOS[indice];
    const ir = (i: number) => {
      indice = Math.max(0, Math.min(PASOS.length - 1, i));
      pintar();
      if (indice > 0) raiz.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    };
    const siguiente = () => ir(indice + 1);
    /** Vuelve al principio del test (las pruebas que se repintan sin cambiar de paso lo necesitan). */
    const alTope = () => raiz.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    const esNino = () => perfil === 'nino';

    function ojosSvg(tapar: Ojo | null): string {
      // Se dibuja como te ves tú: tu ojo izquierdo, a la izquierda.
      const ojo = (cx: number, cubierto: boolean) =>
        cubierto
          ? `<g class="mano"><rect x="${cx - 38}" y="14" width="76" height="64" rx="26" fill="#e6c7a4" stroke="#171411" stroke-width="3"/><path d="M${cx - 18} 30v-6M${cx} 28v-8M${cx + 18} 30v-6" stroke="#171411" stroke-width="3" stroke-linecap="round"/></g>`
          : `<ellipse cx="${cx}" cy="46" rx="32" ry="20" fill="#fff" stroke="#171411" stroke-width="3"/><circle cx="${cx}" cy="46" r="12" fill="#87572c"/><circle cx="${cx}" cy="46" r="5" fill="#171411"/><circle cx="${cx + 4}" cy="42" r="2.5" fill="#fff"/>`;
      return `<svg class="tv-ojos" viewBox="0 0 220 104" role="img" aria-label="${tapar ? `Tapa el ${NOMBRE_OJO[tapar]}` : 'Con los dos ojos abiertos'}">
        ${ojo(58, tapar === 'izquierdo')}${ojo(162, tapar === 'derecho')}
        <text x="58" y="98" text-anchor="middle" font-size="13" font-weight="800" fill="#665e54">Izquierdo</text>
        <text x="162" y="98" text-anchor="middle" font-size="13" font-weight="800" fill="#665e54">Derecho</text>
      </svg>`;
    }
    const cabeceraOjo = (probar: Ojo, extra = '') => `
      <div class="tv-ojo-cab">
        ${ojosSvg(OTRO_OJO[probar])}
        <p>${esNino() ? `Tapa al niño el ${NOMBRE_OJO[OTRO_OJO[probar]]}` : `Tápate el ${NOMBRE_OJO[OTRO_OJO[probar]]}`}<small>con la palma de la mano, sin apretar. Se mira con el ${NOMBRE_OJO[probar]}.${extra}</small></p>
      </div>`;
    const avisoGafas = () =>
      `<p class="tv-chico">${usaGafas ? 'Con las gafas o lentillas puestas, como se usan normalmente.' : 'Sin gafas, como se ve normalmente.'}</p>`;

    // ── Pintar según el paso ──────────────────────────────────────────────
    function pintar() {
      limpiezas.forEach((f) => f());
      limpiezas = [];
      const p = paso();
      cab.hidden = p.tipo === 'intro';
      const pct = Math.round((indice / (PASOS.length - 1)) * 100);
      barra.style.width = `${pct}%`;
      progreso.setAttribute('aria-valuenow', String(pct));
      etiquetaPaso.textContent = `${TITULOS[p.tipo]}${p.ojo ? ` · ${NOMBRE_OJO[p.ojo]}` : ''} · paso ${indice} de ${PASOS.length - 1}`;
      escena.replaceChildren();
      escena.classList.remove('compacta');
      ({ intro, calibrar, agudeza: pintarAgudeza, duocromo: pintarDuocromo, astigmatismo: pintarAstigmatismo, cerca: pintarCerca, color: pintarColor, amsler: pintarAmsler, informe })[p.tipo]();
      // El foco al principio de la escena ayuda a quien usa lector de pantalla o teclado.
      const t = escena.querySelector<HTMLElement>('h2, h3');
      if (t && indice > 0) {
        t.tabIndex = -1;
        t.focus({ preventScroll: true });
      }
    }

    const html = (s: string) => {
      escena.insertAdjacentHTML('beforeend', s);
    };
    const en = <T extends HTMLElement>(sel: string) => escena.querySelector<T>(sel)!;

    // ── 0 · Intro ─────────────────────────────────────────────────────────
    function intro() {
      html(`
        <div>
          <span class="antetitulo sin-raya">5 minutos · sin registro · nada sale de tu dispositivo</span>
          <h2 style="margin-top:10px">Comprueba cómo ves, ahora mismo</h2>
        </div>
        <p class="tv-texto">Pruebas guiadas de <strong>agudeza visual, astigmatismo, visión de cerca, color y la cuadrícula de Amsler</strong> (la que detecta problemas en el centro de la retina). Al final te damos un resultado en semáforo y, si quieres, <strong>reservas tu revisión gratuita</strong> con los datos ya preparados.</p>

        <fieldset class="tv-grupo">
          <legend>Antes de nada: ¿hay ahora mismo alguno de estos síntomas?</legend>
          <label class="tv-opcion"><input type="checkbox" data-urgente /><span>Pérdida brusca de visión, destellos de luz, una «cortina» o sombra, dolor intenso en el ojo o visión doble repentina.</span></label>
        </fieldset>
        <div class="tv-alerta" data-alerta-urgente hidden role="alert">
          <strong>No hagas el test: necesitas atención médica hoy.</strong>
          <span>Estos síntomas pueden ser una urgencia oftalmológica. Acude a urgencias de un hospital o llama al 112. No esperes a una cita.</span>
          <div class="tv-acciones"><a class="boton" href="tel:112" style="--fondo:var(--tv-pronto)">Llamar al 112</a></div>
        </div>

        <div data-ajustes class="tv-ajustes">
          <fieldset class="tv-grupo">
            <legend>¿Para quién es el test?</legend>
            <div class="tv-opciones">
              <label class="tv-opcion"><input type="radio" name="perfil" value="adulto" checked /><span>Para mí<small>Adultos y jóvenes</small></span></label>
              <label class="tv-opcion"><input type="radio" name="perfil" value="nino" /><span>Para un niño o niña<small>De 3 a 12 años, con un adulto</small></span></label>
            </div>
          </fieldset>
          <fieldset class="tv-grupo" data-edad hidden>
            <legend>¿Qué edad tiene?</legend>
            <div class="tv-opciones">
              <label class="tv-opcion"><input type="radio" name="edad" value="menor6" /><span>Menos de 6 años</span></label>
              <label class="tv-opcion"><input type="radio" name="edad" value="mayor6" checked /><span>6 años o más</span></label>
            </div>
          </fieldset>
          <fieldset class="tv-grupo">
            <legend data-leyenda-gafas>¿Usas gafas o lentillas para ver de lejos?</legend>
            <div class="tv-opciones">
              <label class="tv-opcion"><input type="radio" name="gafas" value="si" /><span>Sí, las llevaré puestas<small>Medimos cómo se ve con ellas</small></span></label>
              <label class="tv-opcion"><input type="radio" name="gafas" value="no" checked /><span>No uso<small>Medimos la visión natural</small></span></label>
            </div>
          </fieldset>
          <fieldset class="tv-grupo">
            <legend>¿Desde qué dispositivo lo haces?</legend>
            <div class="tv-opciones">
              <label class="tv-opcion"><input type="radio" name="disp" value="movil" ${dispositivo === 'movil' ? 'checked' : ''} /><span>Móvil o tableta<small>Con el brazo estirado (60 cm)</small></span></label>
              <label class="tv-opcion"><input type="radio" name="disp" value="ordenador" ${dispositivo === 'ordenador' ? 'checked' : ''} /><span>Ordenador<small>A un metro de la pantalla</small></span></label>
            </div>
          </fieldset>
          <div class="tv-aviso-legal">${ico.info}<span><strong>Es orientativo.</strong> No es una graduación ni un diagnóstico: sirve para detectar señales y llegar a la revisión con datos. Necesitarás una <strong>tarjeta bancaria</strong> (o cualquier otra del mismo tamaño) para calibrar la pantalla.</span></div>
          <div class="tv-acciones"><button class="boton" data-accion="empezar" type="button">Empezar el test</button></div>
        </div>
      `);
      const urgente = en<HTMLInputElement>('[data-urgente]');
      urgente.addEventListener('change', () => {
        en('[data-alerta-urgente]').hidden = !urgente.checked;
        en('[data-ajustes]').hidden = urgente.checked;
      });
      escena.querySelectorAll<HTMLInputElement>('input[name="perfil"]').forEach((r) =>
        r.addEventListener('change', () => {
          const nino = escena.querySelector<HTMLInputElement>('input[name="perfil"]:checked')?.value === 'nino';
          en('[data-edad]').hidden = !nino;
          en('[data-leyenda-gafas]').textContent = nino ? '¿Usa gafas o lentillas?' : '¿Usas gafas o lentillas para ver de lejos?';
        }),
      );
      en('[data-accion="empezar"]').addEventListener('click', () => {
        const val = (n: string) => escena.querySelector<HTMLInputElement>(`input[name="${n}"]:checked`)?.value;
        usaGafas = val('gafas') === 'si';
        perfil = val('perfil') === 'nino' ? 'nino' : 'adulto';
        edadNino = val('edad') === 'menor6' ? 'menor6' : 'mayor6';
        PASOS = perfil === 'nino' ? PASOS_NINO : PASOS_ADULTO;
        const d = val('disp') as Dispositivo | undefined;
        if (d && d !== dispositivo) {
          dispositivo = d;
          let guardado = false;
          try { guardado = Number(localStorage.getItem('siente-tv-px')) > 0; } catch {}
          if (!guardado) {
            pxMm = d === 'movil' ? 6.3 : 3.78;
            anchoTarjetaPx = pxMm * TARJETA_MM.ancho;
          }
        }
        evento('test_vista_inicio', { perfil, dispositivo });
        siguiente();
      });
    }

    // ── 1 · Calibración y brillo ──────────────────────────────────────────
    function calibrar() {
      const disponible = Math.max(160, Math.min(escena.clientWidth - 8, 560));
      anchoTarjetaPx = Math.min(Math.max(anchoTarjetaPx, 120), disponible);
      html(`
        <div><h2>Calibremos la pantalla</h2></div>
        <p class="tv-texto">Para que las figuras tengan el tamaño exacto necesitamos saber cuánto mide tu pantalla. <strong>Apoya una tarjeta bancaria en vertical contra la pantalla</strong> y ajusta el rectángulo hasta que sus bordes laterales coincidan con las líneas naranjas.</p>
        <svg class="tv-ayuda" viewBox="0 0 200 96" role="img" aria-label="Una tarjeta apoyada en vertical sobre la pantalla del móvil">
          <rect x="62" y="6" width="76" height="84" rx="10" fill="#fff" stroke="#171411" stroke-width="3"/>
          <rect x="72" y="14" width="56" height="62" rx="3" fill="#f1e9dd"/>
          <g class="tarjeta-anim"><rect x="86" y="22" width="30" height="48" rx="3" fill="#e6d6bf" stroke="#171411" stroke-width="2.5"/><rect x="90" y="28" width="9" height="7" rx="1.5" fill="#b9844f"/></g>
          <path d="M86 78v-4M116 78v-4" stroke="#87572c" stroke-width="2" stroke-dasharray="2 2"/>
        </svg>
        <div class="tv-calib">
          <div class="tv-tarjeta" data-tarjeta style="width:${anchoTarjetaPx}px"><span>Tarjeta<br />bancaria</span></div>
          <div class="tv-calib-control">
            <button class="tv-paso-boton" type="button" data-ajuste="-1" aria-label="Más estrecho">−</button>
            <input type="range" min="120" max="${Math.round(disponible)}" step="0.5" value="${anchoTarjetaPx}" data-rango aria-label="Ancho de la tarjeta en pantalla" />
            <button class="tv-paso-boton" type="button" data-ajuste="1" aria-label="Más ancho">+</button>
          </div>
        </div>
        <p class="tv-chico">Si no tienes tarjeta, vale cualquier carné de plástico del mismo tamaño (DNI, carné de conducir). Si tu navegador está con zoom, ponlo al 100 %.</p>

        <fieldset class="tv-grupo">
          <legend>Brillo: ¿cuántos cuadrados claros distingues del fondo negro?</legend>
          <div class="tv-grises" aria-hidden="true">${ESCALA_GRISES.map((g) => `<i style="background:rgb(${g},${g},${g})"></i>`).join('')}</div>
          <p class="tv-chico">Sube el brillo al máximo y desactiva el modo noche o el filtro de luz azul. El primer cuadrado es negro puro y no se ve a propósito: cuenta los otros cinco, cada vez más claros hacia la derecha.</p>
          <div class="tv-opciones">
            <label class="tv-opcion"><input type="radio" name="brillo" value="bien" checked /><span>Veo al menos cuatro de los cinco</span></label>
            <label class="tv-opcion"><input type="radio" name="brillo" value="bajo" /><span>Veo menos de cuatro</span></label>
          </div>
          <p class="tv-chico" data-aviso-brillo hidden><strong>Sube el brillo</strong> o desactiva el modo noche. Si no puedes, sigue, pero el resultado será menos fiable.</p>
        </fieldset>
        <div class="tv-acciones">
          <button class="boton" type="button" data-accion="ok">Ya coincide, continuar</button>
          <button class="boton secundario" type="button" data-accion="atras">Atrás</button>
        </div>
      `);
      const tarjeta = en('[data-tarjeta]');
      const rango = en<HTMLInputElement>('[data-rango]');
      const poner = (v: number) => {
        anchoTarjetaPx = Math.min(Math.max(v, +rango.min), +rango.max);
        rango.value = String(anchoTarjetaPx);
        tarjeta.style.width = `${anchoTarjetaPx}px`;
      };
      rango.addEventListener('input', () => poner(+rango.value));
      escena.querySelectorAll<HTMLElement>('[data-ajuste]').forEach((b) =>
        b.addEventListener('click', () => poner(anchoTarjetaPx + Number(b.dataset.ajuste) * 1)),
      );
      escena.querySelectorAll<HTMLInputElement>('input[name="brillo"]').forEach((r) =>
        r.addEventListener('change', () => {
          en('[data-aviso-brillo]').hidden = r.value !== 'bajo' || !r.checked;
        }),
      );
      en('[data-accion="atras"]').addEventListener('click', () => ir(0));
      en('[data-accion="ok"]').addEventListener('click', () => {
        pxMm = pxPorMm(anchoTarjetaPx);
        brilloBajo = escena.querySelector<HTMLInputElement>('input[name="brillo"]:checked')?.value === 'bajo';
        try { localStorage.setItem('siente-tv-px', String(cuadrar(pxMm))); } catch {}
        siguiente();
      });
    }

    // ── 2 · Agudeza visual (aro de Landolt; «E» para niños) ───────────────
    const DIRS = [
      { id: 'der', giro: 0, voz: ['derecha'] },
      { id: 'abajo', giro: 90, voz: ['abajo'] },
      { id: 'izq', giro: 180, voz: ['izquierda'] },
      { id: 'arriba', giro: 270, voz: ['arriba'] },
    ] as const;

    function landolt(diametro: number, giro: number): string {
      const c = 4 * Math.PI;
      // La abertura mide 1 unidad (el trazo también); se centra a la derecha y se gira.
      const compensa = (0.5 / c) * 360;
      return `<svg class="tv-optotipo" viewBox="0 0 5 5" width="${diametro}" height="${diametro}" shape-rendering="geometricPrecision" overflow="visible" aria-hidden="true">
        <circle cx="2.5" cy="2.5" r="2" fill="none" stroke="#000" stroke-width="1" stroke-dasharray="${c - 1} 1" transform="rotate(${giro + compensa} 2.5 2.5)"/>
      </svg>`;
    }
    /** «E» de Snellen: 5 × 5 unidades, trazos de 1; los «dientes» miran a la derecha con giro 0. */
    function letraE(diametro: number, giro: number): string {
      return `<svg class="tv-optotipo" viewBox="0 0 5 5" width="${diametro}" height="${diametro}" shape-rendering="crispEdges" overflow="visible" aria-hidden="true">
        <path d="M0 0H1V5H0Z M1 0H5V1H1Z M1 2H4V3H1Z M1 4H5V5H1Z" fill="#000" transform="rotate(${giro} 2.5 2.5)"/>
      </svg>`;
    }
    const optotipo = () => (esNino() ? letraE : landolt);

    /** Cámara (si el navegador sabe detectar caras): avisa de «acércate» o «aléjate». */
    function ayudaCamara() {
      const FD = (window as unknown as { FaceDetector?: new (o?: object) => { detect(v: HTMLVideoElement): Promise<{ boundingBox: DOMRectReadOnly }[]> } }).FaceDetector;
      if (!FD || !navigator.mediaDevices?.getUserMedia) return '';
      return `<div class="tv-camara" data-camara>
        <button class="boton secundario pequeno" type="button" data-accion="camara">${ico.cam} Comprobar la distancia con la cámara</button>
        <div class="tv-camara-vista" data-camara-vista hidden>
          <video playsinline muted aria-hidden="true"></video>
          <p aria-live="polite" data-camara-texto>Buscando tu cara…</p>
        </div>
        <p class="tv-chico">La cámara solo se usa para estimar la distancia: no se graba ni sale de tu dispositivo.</p>
      </div>`;
    }
    function activarCamara(objetivoMm: number) {
      const FD = (window as unknown as { FaceDetector: new (o?: object) => { detect(v: HTMLVideoElement): Promise<{ boundingBox: DOMRectReadOnly }[]> } }).FaceDetector;
      const boton = escena.querySelector<HTMLButtonElement>('[data-accion="camara"]');
      const vista = escena.querySelector<HTMLElement>('[data-camara-vista]');
      const texto = escena.querySelector<HTMLElement>('[data-camara-texto]');
      const video = vista?.querySelector('video');
      if (!boton || !vista || !texto || !video) return;
      boton.addEventListener('click', async () => {
        boton.disabled = true;
        try {
          const flujo = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false });
          video.srcObject = flujo;
          await video.play();
          vista.hidden = false;
          const detector = new FD({ fastMode: true, maxDetectedFaces: 1 });
          let vivo = true;
          limpiezas.push(() => {
            vivo = false;
            flujo.getTracks().forEach((t) => t.stop());
          });
          const mensajes = {
            bien: 'Distancia correcta. No te muevas.',
            acerca: 'Estás lejos: acerca un poco la pantalla.',
            aleja: 'Estás cerca: aleja un poco la pantalla.',
          } as const;
          while (vivo) {
            const caras = await detector.detect(video).catch(() => []);
            if (caras[0]) {
              const mm = distanciaCamaraMm(caras[0].boundingBox.width, video.videoWidth, esNino() ? 120 : 140);
              texto.textContent = `≈ ${Math.round(mm / 10)} cm (objetivo ${objetivoMm / 10}). ${mensajes[consejoDistancia(mm, objetivoMm)]}`;
            } else texto.textContent = 'No veo tu cara: mira a la cámara.';
            await new Promise((r) => setTimeout(r, 350));
          }
        } catch {
          texto.textContent = 'No se ha podido usar la cámara. Mide la distancia con el brazo estirado.';
          vista.hidden = false;
        }
      });
    }

    function pintarAgudeza() {
      const ojo = paso().ojo!;
      const distancia = DISTANCIA_MM[dispositivo];
      html(`
        <div><h2>Agudeza visual</h2></div>
        ${cabeceraOjo(ojo)}
        <div class="tv-dist"><b>${distancia / 10} cm</b><span>${
          dispositivo === 'movil'
            ? 'Sostén el móvil con el <strong>brazo estirado</strong> y mantén esa distancia durante toda la prueba.'
            : 'Siéntate a <strong>un metro</strong> de la pantalla (dos largos de brazo) y mantén la distancia.'
        }</span></div>
        ${ayudaCamara()}
        ${avisoGafas()}
        <p class="tv-texto">${
          esNino()
            ? 'Saldrá una <strong>«E»</strong> como un tenedor. Que el niño señale con el dedo hacia dónde miran los dientes y <strong>pulsa tú la flecha</strong>. Si no la distingue, pulsa «No lo veo». Pon el brillo al máximo.'
            : 'Verás un aro con un hueco. <strong>Pulsa la flecha hacia donde mira el hueco.</strong> Si no lo distingues, pulsa «No lo veo»: no pasa nada, es parte de la prueba. Pon el brillo al máximo.'
        }</p>
        <div class="tv-acciones"><button class="boton" type="button" data-accion="listo">Estoy listo</button></div>
      `);
      activarCamara(distancia);
      en('[data-accion="listo"]').addEventListener('click', () => ensayoAgudeza(ojo));
    }

    function ensayoAgudeza(ojo: Ojo) {
      limpiezas.forEach((f) => f());
      limpiezas = [];
      const distancia = DISTANCIA_MM[dispositivo];
      const dibujar = optotipo();
      const aciertos: number[] = [];
      let nivel = 0;
      let buenos = 0;
      let malos = 0;
      let actual = 0;
      let ultimaDir = -1;
      let bloqueado = false;

      escena.replaceChildren();
      escena.classList.add('compacta');
      const SR = (window as unknown as { SpeechRecognition?: new () => any; webkitSpeechRecognition?: new () => any });
      const Voz = SR.SpeechRecognition ?? SR.webkitSpeechRecognition;
      html(`
        <div class="tv-escenario" data-escenario aria-live="off"></div>
        <div class="tv-puntos" aria-hidden="true">${NIVELES.map(() => '<i></i>').join('')}</div>
        <p class="tv-chico" style="text-align:center">${NOMBRE_OJO[ojo][0].toUpperCase() + NOMBRE_OJO[ojo].slice(1)} · ${esNino() ? '¿Hacia dónde miran los dientes de la E?' : '¿Hacia dónde mira el hueco?'}</p>
        <div class="tv-cruz" role="group" aria-label="Dirección">
          ${DIRS.map((d) => `<button type="button" class="tv-flecha" data-dir="${d.id}" aria-label="${{ der: 'Derecha', abajo: 'Abajo', izq: 'Izquierda', arriba: 'Arriba' }[d.id]}">${ico.flecha(d.giro)}</button>`).join('')}
          <button type="button" class="tv-nover" data-dir="nover">No lo veo</button>
        </div>
        ${
          Voz && !esNino()
            ? `<div class="tv-voz"><button class="boton secundario pequeno" type="button" data-accion="voz" aria-pressed="false">${ico.mic} Responder con la voz</button>
               <p class="tv-chico" data-voz-texto>Di «arriba», «abajo», «izquierda», «derecha» o «no veo». Tu navegador puede enviar el audio a su fabricante para reconocerlo.</p></div>`
            : ''
        }
      `);
      const caja = en('[data-escenario]');
      const puntos = [...escena.querySelectorAll<HTMLElement>('.tv-puntos i')];
      // Después de pintar: si se pide antes, la página aún es corta y el scroll se queda a medias.
      alTope();

      const mostrar = () => {
        do actual = Math.floor(Math.random() * 4);
        while (actual === ultimaDir);
        ultimaDir = actual;
        const d = Math.max(3, diametroPx(NIVELES[nivel], distancia, pxMm));
        caja.innerHTML = dibujar(d, DIRS[actual].giro);
        bloqueado = false;
      };
      const terminar = () => {
        agudeza[ojo] = aciertos;
        siguiente();
      };
      const responder = (dir: string) => {
        if (bloqueado) return;
        bloqueado = true;
        if (dir === DIRS[actual].id) buenos++;
        else malos++;
        const supera = buenos >= ACIERTOS_PARA_SUPERAR;
        const falla = malos > INTENTOS_POR_NIVEL - ACIERTOS_PARA_SUPERAR;
        caja.firstElementChild?.classList.add('oculto');
        setTimeout(() => {
          if (supera || falla) {
            aciertos.push(buenos);
            puntos[nivel]?.classList.add('hecho');
            if (falla || nivel === NIVELES.length - 1) return terminar();
            nivel++;
            buenos = malos = 0;
          }
          mostrar();
        }, 160);
      };
      escena.querySelectorAll<HTMLElement>('[data-dir]').forEach((b) => b.addEventListener('click', () => responder(b.dataset.dir!)));

      const alTeclado = (e: KeyboardEvent) => {
        const m: Record<string, string> = { ArrowRight: 'der', ArrowLeft: 'izq', ArrowUp: 'arriba', ArrowDown: 'abajo' };
        if (m[e.key]) {
          e.preventDefault();
          responder(m[e.key]);
        }
      };
      document.addEventListener('keydown', alTeclado);
      limpiezas.push(() => document.removeEventListener('keydown', alTeclado));

      // Respuesta por voz (opcional): quien no puede tocar con precisión puede decir la dirección.
      const botonVoz = escena.querySelector<HTMLButtonElement>('[data-accion="voz"]');
      if (botonVoz && Voz) {
        let rec: any = null;
        const parar = () => {
          try { rec?.stop(); } catch {}
          rec = null;
          botonVoz.setAttribute('aria-pressed', 'false');
        };
        limpiezas.push(parar);
        botonVoz.addEventListener('click', () => {
          if (rec) return parar();
          rec = new Voz();
          rec.lang = 'es-ES';
          rec.continuous = true;
          rec.interimResults = false;
          rec.onresult = (e: any) => {
            const dicho = String(e.results[e.results.length - 1][0].transcript).toLowerCase();
            if (/no (lo )?veo|nada/.test(dicho)) return responder('nover');
            const d = DIRS.find((x) => x.voz.some((v) => dicho.includes(v)));
            if (d) responder(d.id);
          };
          rec.onend = () => rec && botonVoz.getAttribute('aria-pressed') === 'true' && rec.start?.();
          rec.onerror = () => parar();
          try {
            rec.start();
            botonVoz.setAttribute('aria-pressed', 'true');
          } catch {
            parar();
          }
        });
      }
      mostrar();
    }

    // ── 3 · Duocromo (rojo / verde) ───────────────────────────────────────
    function pintarDuocromo() {
      const ojo = paso().ojo!;
      const distancia = DISTANCIA_MM[dispositivo];
      const d = Math.max(6, diametroPx(NIVELES.find((n) => n.decimal === 0.4)!, distancia, pxMm));
      const giros = [0, 270, 90, 180];
      const aros = (c: string) =>
        `<div class="tv-duo-lado" style="background:${c}">${giros.map((g) => landolt(d, g)).join('')}</div>`;
      html(`
        <div><h2>¿Dónde se ven más nítidos los aros?</h2></div>
        ${cabeceraOjo(ojo, ` A ${distancia / 10} cm.`)}
        ${avisoGafas()}
        <div class="tv-duo" role="img" aria-label="Aros negros sobre una mitad roja y otra verde">${aros('rgb(215,40,40)')}${aros('rgb(20,150,60)')}</div>
        <fieldset class="tv-grupo">
          <legend>Compara las dos mitades. ¿Dónde se ven más negros y nítidos los aros?</legend>
          <div class="tv-opciones">
            <label class="tv-opcion"><input type="radio" name="duo" value="rojo" /><span>Sobre el rojo</span></label>
            <label class="tv-opcion"><input type="radio" name="duo" value="igual" /><span>Igual en los dos</span></label>
            <label class="tv-opcion"><input type="radio" name="duo" value="verde" /><span>Sobre el verde</span></label>
            <label class="tv-opcion"><input type="radio" name="duo" value="omitida" /><span>No distingo los aros</span></label>
          </div>
        </fieldset>
        <div class="tv-acciones"><button class="boton" type="button" data-accion="sig" disabled>Continuar</button></div>
      `);
      const boton = en<HTMLButtonElement>('[data-accion="sig"]');
      escena.querySelectorAll<HTMLInputElement>('input[name="duo"]').forEach((r) => r.addEventListener('change', () => (boton.disabled = false)));
      boton.addEventListener('click', () => {
        duocromo[ojo] = { lado: escena.querySelector<HTMLInputElement>('input[name="duo"]:checked')!.value as ResultadoDuocromo['lado'] };
        siguiente();
      });
    }

    // ── 4 · Astigmatismo ──────────────────────────────────────────────────
    function pintarAstigmatismo() {
      const ojo = paso().ojo!;
      const distancia = DISTANCIA_MM[dispositivo];
      const lado = Math.round(Math.min(escena.clientWidth - 40, 90 * pxMm, 380));
      const R = lado / 2 - 26;
      const grosor = Math.max(1.6, 0.32 * pxMm);
      const lineas = Array.from({ length: LINEAS_ASTIGMATISMO }, (_, i) => {
        const n = i + 1;
        const a = ((anguloLinea(n) - 90) * Math.PI) / 180; // 6 = vertical
        const x = Math.cos(a) * R;
        const y = Math.sin(a) * R;
        return `<line class="l" data-linea="${n}" x1="${-x}" y1="${-y}" x2="${x}" y2="${y}" stroke-width="${grosor}"/>`;
      }).join('');
      const horas = Array.from({ length: 12 }, (_, i) => {
        const h = i + 1;
        const a = ((h * 30 - 90) * Math.PI) / 180;
        return `<text x="${Math.cos(a) * (R + 15)}" y="${Math.sin(a) * (R + 15) + 5}" text-anchor="middle" font-size="14">${h}</text>`;
      }).join('');
      html(`
        <div><h2>¿Se ven todas las líneas igual?</h2></div>
        ${cabeceraOjo(ojo, ` A ${distancia / 10} cm.`)}
        ${avisoGafas()}
        <div class="tv-dial-caja">
          <svg class="tv-dial" width="${lado}" height="${lado}" viewBox="${-lado / 2} ${-lado / 2} ${lado} ${lado}" role="img" aria-label="Esfera de líneas numeradas como un reloj">
            ${lineas}${horas}<circle r="3" fill="#000"/>
          </svg>
        </div>
        <fieldset class="tv-grupo">
          <legend>Mira el centro. ¿Alguna línea se ve más negra o más nítida que las demás?</legend>
          <div class="tv-chips">
            <label class="tv-chip"><input type="radio" name="linea" value="0" /><span>Todas se ven igual</span></label>
            ${Array.from({ length: LINEAS_ASTIGMATISMO }, (_, i) => `<label class="tv-chip"><input type="radio" name="linea" value="${i + 1}" /><span>La del ${textoEjeLinea(i + 1)}</span></label>`).join('')}
          </div>
        </fieldset>
        <div class="tv-acciones"><button class="boton" type="button" data-accion="sig" disabled>Continuar</button></div>
      `);
      const boton = en<HTMLButtonElement>('[data-accion="sig"]');
      escena.querySelectorAll<HTMLInputElement>('input[name="linea"]').forEach((r) =>
        r.addEventListener('change', () => {
          escena.querySelectorAll('.tv-dial line.l').forEach((l) => l.classList.toggle('sel', l.getAttribute('data-linea') === r.value));
          boton.disabled = false;
        }),
      );
      boton.addEventListener('click', () => {
        const v = Number(escena.querySelector<HTMLInputElement>('input[name="linea"]:checked')?.value ?? 0);
        astigmatismo[ojo] = { linea: v === 0 ? null : v };
        siguiente();
      });
    }

    // ── 5 · Visión de cerca (lectura a 40 cm) ─────────────────────────────
    function pintarCerca() {
      const frases = [
        'El barrio huele a pan recién hecho.',
        'Los aviones cruzan despacio sobre los tejados.',
        'Mi vecina riega las macetas cada mañana temprano.',
        'En la plaza hay un banco de madera y una fuente pequeña.',
        'Antes de salir, comprueba que llevas las llaves y el monedero.',
        'Lee con calma el prospecto: cada comprimido debe tomarse con un poco de agua.',
        'La letra pequeña de los contratos suele esconder condiciones que conviene leer despacio.',
      ];
      const filas = NIVELES_CERCA.map((n, i) => {
        const mm = alturaMayusculasMm(n.decimal, DISTANCIA_CERCA_MM);
        const fuente = Math.max(3, (mm * pxMm) / 0.72); // altura de mayúscula ≈ 0,72 em
        return `<label class="tv-linea-cerca"><input type="radio" name="cerca" value="${n.decimal}" /><span class="tv-linea-texto" style="font-size:${fuente}px">${frases[i]}</span><em>${n.etiqueta}</em></label>`;
      });
      html(`
        <div><h2>¿Hasta qué línea lees con comodidad?</h2></div>
        <div class="tv-dist"><b>${DISTANCIA_CERCA_MM / 10} cm</b><span>Sostén el móvil a <strong>unos 40 cm</strong> (antebrazo apoyado en el codo). Con los dos ojos abiertos.</span></div>
        <p class="tv-chico">${usaGafas ? 'Con las gafas que uses para leer, si tienes.' : 'Si usas gafas de cerca, póntelas.'} Si tienes que alejar el móvil para ver bien, es justo lo que queremos saber.</p>
        <fieldset class="tv-grupo">
          <legend>Marca la línea más pequeña que lees sin esfuerzo</legend>
          <div class="tv-cerca">${filas.join('')}</div>
          <label class="tv-opcion"><input type="radio" name="cerca" value="0" /><span>No leo ninguna con comodidad</span></label>
        </fieldset>
        <label class="tv-opcion"><input type="checkbox" data-aleja /><span>Tengo que alejar el móvil o el papel para leer bien<small>Aunque sea un poco</small></span></label>
        <div class="tv-acciones"><button class="boton" type="button" data-accion="sig" disabled>Continuar</button></div>
      `);
