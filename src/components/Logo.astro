---
import LogoMarca from './LogoMarca.astro';
import { url } from '../lib/url';

interface Props {
  claro?: boolean;
  class?: string;
}
const { claro = false, class: clase = '' } = Astro.props;
---

<a href={url('/')} class:list={['logo', clase, { claro }]}>
  <LogoMarca class="logo-icono" />
  <span class="logo-texto">
    <span class="logo-nombre">SIENTE</span>
    <span class="logo-sub">Centro óptico &amp; auditivo</span>
    <span class="sr-only">, ir al inicio</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--tinta);
  }
  .logo.claro { color: var(--papel); }
  .logo :global(.logo-icono) { width: 66px; height: auto; flex: none; }
  .logo-texto { display: grid; line-height: 1; }
  .logo-nombre {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: 0.04em;
  }
  .logo-sub {
    margin-top: 5px;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.85;
  }
</style>
