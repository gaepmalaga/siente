---
// Mapa «de fachada»: una ilustración ligera que solo carga OpenStreetMap si la
// persona lo pide. Así no hay cookies de terceros ni peso extra al entrar.
import Icono from './Icono.astro';
import IconoMarca from './IconoMarca.astro';
import { negocio, mapas, direccionCompleta } from '../lib/negocio';

const { lat, lng } = negocio.geo;
const d = 0.0045;
const osm = `https://www.openstreetmap.org/export/embed.html?bbox=${lng - d}%2C${lat - d / 1.6}%2C${lng + d}%2C${lat + d / 1.6}&layer=mapnik&marker=${lat}%2C${lng}`;
---

<div class="mapa">
  <div class="mapa-lienzo" data-mapa data-src={osm}>
    <svg class="mapa-ilustracion" viewBox="0 0 600 380" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
      <rect width="600" height="380" fill="#efe6d8"></rect>
      <g fill="#e3d6c2">
        <rect x="30" y="30" width="150" height="90" rx="10"></rect>
        <rect x="30" y="150" width="150" height="110" rx="10"></rect>
        <rect x="30" y="290" width="150" height="70" rx="10"></rect>
        <rect x="330" y="20" width="110" height="120" rx="10"></rect>
        <rect x="470" y="20" width="110" height="120" rx="10"></rect>
        <rect x="330" y="170" width="250" height="80" rx="10"></rect>
        <rect x="330" y="280" width="120" height="80" rx="10"></rect>
        <rect x="480" y="280" width="100" height="80" rx="10"></rect>
      </g>
      <rect x="470" y="282" width="108" height="76" rx="10" fill="#cfe0bd"></rect>
      <g stroke="#fff" stroke-linecap="round" fill="none">
        <path d="M250 -10 C 255 120, 245 260, 252 400" stroke-width="34"></path>
        <path d="M-10 135 H 610" stroke-width="16"></path>
        <path d="M-10 272 H 320" stroke-width="16"></path>
        <path d="M455 150 V 400" stroke-width="12"></path>
      </g>
      <text x="268" y="236" font-family="Atkinson Hyperlegible Next, sans-serif" font-size="15" font-weight="700" fill="#87572c" transform="rotate(90 268 236)">AV. DE LOGROÑO</text>
    </svg>
    <div class="mapa-pin" aria-hidden="true">
      <span class="mapa-pin-icono"><Icono nombre="MapPin" /></span>
      <span class="mapa-pin-texto">Siente</span>
    </div>
    <button type="button" class="boton claro pequeno mapa-cargar" data-cargar-mapa>
      <Icono nombre="Map" /> Ver mapa interactivo
    </button>
  </div>
  <div class="mapa-pie">
    <p><strong>{direccionCompleta}</strong></p>
    <div class="mapa-botones">
      <a class="boton pequeno" href={mapas.comoLlegar} target="_blank" rel="noopener"><IconoMarca nombre="googlemaps" /> Google Maps</a>
      <a class="boton pequeno secundario" href={mapas.apple} target="_blank" rel="noopener"><IconoMarca nombre="apple" /> Apple</a>
      <a class="boton pequeno secundario" href={mapas.waze} target="_blank" rel="noopener"><IconoMarca nombre="waze" /> Waze</a>
    </div>
  </div>
</div>

<style>
  .mapa { display: grid; gap: 18px; }
  .mapa-lienzo {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radio-l);
    overflow: hidden;
    background: #efe6d8;
    box-shadow: inset 0 0 0 1px var(--linea);
  }
  .mapa-ilustracion { width: 100%; height: 100%; }
  .mapa-pin {
    position: absolute;
    left: 42%;
    top: 46%;
    display: flex;
    align-items: center;
    gap: 8px;
    transform: translate(-20px, -100%);
    filter: drop-shadow(0 8px 12px rgb(23 20 17 / 0.3));
  }
  .mapa-pin-icono {
    display: grid; place-items: center;
    width: 46px; height: 46px;
    border-radius: 50% 50% 50% 4px;
    transform: rotate(-45deg);
    background: var(--tinta); color: var(--luz);
  }
  .mapa-pin-icono :global(.icono) { width: 22px; height: 22px; transform: rotate(45deg); }
  .mapa-pin-texto {
    padding: 6px 12px; border-radius: 999px;
    background: var(--tinta); color: var(--papel);
    font-family: var(--mono); font-weight: 700; letter-spacing: 0.06em;
  }
  .mapa-cargar { position: absolute; right: 14px; bottom: 14px; box-shadow: var(--sombra-1); }
  .mapa-lienzo :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .mapa-pie { display: grid; gap: 12px; }
  .mapa-botones { display: flex; flex-wrap: wrap; gap: 8px; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-mapa]').forEach((lienzo) => {
    lienzo.querySelector('[data-cargar-mapa]')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = lienzo.dataset.src ?? '';
      iframe.title = 'Mapa con la ubicación de Siente en Barajas';
      iframe.loading = 'lazy';
      lienzo.replaceChildren(iframe);
    });
  });
</script>
