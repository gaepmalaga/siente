---
// Llamada a la acción final, común a todas las páginas.
import Icono from './Icono.astro';
import IconoMarca from './IconoMarca.astro';
import LogoMarca from './LogoMarca.astro';
import EstadoApertura from './EstadoApertura.astro';
import { negocio, telHref, waHref, WA_SALUDO } from '../lib/negocio';
import { url } from '../lib/url';

interface Props {
  titulo?: string;
  texto?: string;
  servicio?: string;
}
const {
  titulo = '¿Hablamos? Te esperamos en Barajas',
  texto = 'Pide tu cita por WhatsApp, por teléfono o en un minuto desde la web. Sin listas de espera eternas y sin compromiso.',
  servicio,
} = Astro.props;
const enlaceCita = url(`/pedir-cita/${servicio ? `?servicio=${servicio}` : ''}`);
---

<section class="banda-cita" aria-label="Pedir cita">
  <div class="contenedor banda-dentro" data-aparecer>
    <LogoMarca class="banda-marca" animado />
    <div class="banda-texto">
      <h2>{titulo}</h2>
      <p>{texto}</p>
      <EstadoApertura class="banda-estado" />
    </div>
    <div class="banda-acciones">
      <a class="boton claro" href={enlaceCita}><Icono nombre="CalendarCheck" /> Pedir cita</a>
      <a class="boton wa" href={waHref(WA_SALUDO)} target="_blank" rel="noopener"><IconoMarca nombre="whatsapp" /> WhatsApp</a>
      <a class="boton contorno-claro" href={telHref()}><Icono nombre="Phone" /> {negocio.telefono}</a>
    </div>
  </div>
</section>

<style>
  .banda-cita {
    padding-block: var(--seccion);
    background: var(--tinta);
    color: var(--papel);
    overflow: hidden;
  }
  .banda-dentro {
    position: relative;
    display: grid;
    gap: 32px;
  }
  .banda-dentro :global(.banda-marca) {
    width: min(520px, 90%);
    color: var(--roble);
    opacity: 0.9;
  }
  .banda-texto { display: grid; gap: 16px; }
  .banda-texto h2 { font-size: var(--paso-4); max-width: 16ch; }
  .banda-texto p { font-size: var(--paso-1); color: rgb(248 244 238 / 0.78); max-width: 52ch; }
  .banda-texto :global(.banda-estado) { color: var(--roble-claro); }
  .banda-acciones { display: flex; flex-wrap: wrap; gap: 12px; align-content: start; }
  @media (min-width: 1000px) {
    .banda-dentro { grid-template-columns: 1.4fr 1fr; align-items: end; }
    .banda-dentro :global(.banda-marca) { grid-column: 1 / -1; width: 380px; }
    .banda-acciones { flex-direction: column; align-items: stretch; }
  }
</style>
